<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ControlTemplate x:Key="ESelectedIndicator_BaseTemplate" TargetType="controls:ESelectedIndicator">
        <Border x:Name="PART_ESelectedIndicatorRoot" CornerRadius="{TemplateBinding EBorderCornerRadius}"
                ext:StateListener.Listener="{Binding RelativeSource={RelativeSource AncestorType=controls:ESelectedIndicator}}">
            <Border.OpacityMask>
                <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{x:Reference PART_ESelectedIndicatorRoot}"/>
            </Border.OpacityMask>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="c0" Width="*"/>
                    <ColumnDefinition x:Name="c1" Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="r0" Height="*"/>
                    <RowDefinition x:Name="r1" Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="PART_MainBorder" Grid.Column="0" Grid.Row="0" 
                        BorderThickness="{TemplateBinding EBorderThickness}">
                    <ContentControl x:Name="PART_ContentContainer"
                                    Foreground="{TemplateBinding FontBrush}" Background="Transparent" Margin="{TemplateBinding Padding}" >
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </ContentControl>
                </Border>
                <Grid x:Name="PART_IndicatorContainer" Grid.Column="0" Grid.Row="1">
                    <Line x:Name="PART_SelectionIndicator" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Margin="1"
                          StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                          Opacity="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TransNormSelectionProgress}"
                          StrokeThickness="{Binding RelativeSource={RelativeSource AncestorType=controls:ESelectedIndicator}, Path=SelectedItemLineWidth}"/>
                    <Grid.MaxWidth>
                        <MultiBinding Converter="{StaticResource ExpressionConverter}" ConverterParameter="V0*V1*V2">
                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="TransNormSelectionProgress"/>
                            <Binding Path="SelectedItemLineLengthRate" RelativeSource="{RelativeSource AncestorType=controls:ESelectedIndicator}"/>
                            <Binding ElementName="PART_MainBorder" Path="ActualWidth"/>
                        </MultiBinding>
                    </Grid.MaxWidth>
                </Grid>
            </Grid>
            <ext:StateListener.Rules>
                <ext:RuleCollection>
                    <ext:Rule Target="{Binding ElementName=PART_MainBorder}" StateMap="MouseOut=>Border=PR; MouseIn=>Border=SE;"/>
                    <ext:Rule Target="{Binding ElementName=PART_ESelectedIndicatorRoot}" StateMap="MouseOut=>Back=BC; MouseIn=>Back=Lerp(BC, SE, 0.1); MouseDown=>Back=Lerp(BC, SE, 0.15)"/>
                    <ext:Rule Target="{Binding ElementName=PART_SelectionIndicator}" StateMap="MouseOut=>Stroke=PR; MouseIn=>Stroke=SE;"/>
                </ext:RuleCollection>
            </ext:StateListener.Rules>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IndicatorPlacement" Value="Down">
                <Setter TargetName="PART_IndicatorContainer" Property="Grid.Row" Value="1"/>
                <Setter TargetName="PART_IndicatorContainer" Property="Grid.Column" Value="0"/>
                <Setter TargetName="r0" Property="Height" Value="*"/>
                <Setter TargetName="r1" Property="Height" Value="Auto"/>
            </Trigger>
            <Trigger Property="IndicatorPlacement" Value="Up">
                <Setter TargetName="PART_MainBorder" Property="Grid.Row" Value="1"/>
                <Setter TargetName="PART_IndicatorContainer" Property="Grid.Row" Value="0"/>
                <Setter TargetName="r0" Property="Height" Value="Auto"/>
                <Setter TargetName="r1" Property="Height" Value="*"/>
            </Trigger>
            <Trigger Property="IndicatorPlacement" Value="Left">
                <Setter TargetName="PART_MainBorder" Property="Grid.Column" Value="1"/>
                <Setter TargetName="PART_IndicatorContainer" Property="Grid.Column" Value="0"/>
                <Setter TargetName="PART_IndicatorContainer" Property="Grid.Row" Value="0"/>
                <Setter TargetName="c0" Property="Width" Value="Auto"/>
                <Setter TargetName="c1" Property="Width" Value="*"/>
                <Setter TargetName="PART_SelectionIndicator" Property="X2" Value="0"/>
                <Setter TargetName="PART_SelectionIndicator" Property="Y2" Value="1"/>
                <Setter TargetName="PART_IndicatorContainer" Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}"/>
                <Setter TargetName="PART_IndicatorContainer" Property="MaxHeight">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ExpressionConverter}" ConverterParameter="V0*V1*V2">
                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="TransNormSelectionProgress"/>
                            <Binding Path="SelectedItemLineLengthRate" RelativeSource="{RelativeSource AncestorType=controls:ESelectedIndicator}"/>
                            <Binding ElementName="PART_MainBorder" Path="ActualHeight"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IndicatorPlacement" Value="Right">
                <Setter TargetName="PART_MainBorder" Property="Grid.Column" Value="0"/>
                <Setter TargetName="PART_IndicatorContainer" Property="Grid.Column" Value="1"/>
                <Setter TargetName="PART_IndicatorContainer" Property="Grid.Row" Value="0"/>
                <Setter TargetName="c0" Property="Width" Value="*"/>
                <Setter TargetName="c1" Property="Width" Value="Auto"/>
                <Setter TargetName="PART_SelectionIndicator" Property="X2" Value="0"/>
                <Setter TargetName="PART_SelectionIndicator" Property="Y2" Value="1"/>
                <Setter TargetName="PART_IndicatorContainer" Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}"/>
                <Setter TargetName="PART_IndicatorContainer" Property="MaxHeight">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource ExpressionConverter}" ConverterParameter="V0*V1*V2">
                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="TransNormSelectionProgress"/>
                            <Binding Path="SelectedItemLineLengthRate" RelativeSource="{RelativeSource AncestorType=controls:ESelectedIndicator}"/>
                            <Binding ElementName="PART_MainBorder" Path="ActualHeight"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="controls:ESelectedIndicator">
        <Setter Property="Padding" Value="5,2,5,-3"/>
        <Setter Property="SelectedItemLineWidth" Value="2"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="EBorderThickness" Value="1"/>
        <Setter Property="EBorderCornerRadius" Value="2"/>
        <Setter Property="Template" Value="{StaticResource ESelectedIndicator_BaseTemplate}"/>
    </Style>
</ResourceDictionary>