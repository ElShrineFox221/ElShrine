<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:ElShrine.Wpf.UITheme"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="{x:Type controls:ETextBox}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="1.5"/>
        <Setter Property="EBorderThickness" Value="1"/>
        <Setter Property="EBorderCornerRadius" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ETextBox}">
                    <ControlTemplate.Resources>
                        <system:Double x:Key="halfDouble">0.5</system:Double>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_ETextBoxRoot" ext:StateListener.Listener="{Binding RelativeSource={RelativeSource AncestorType=controls:ETextBox}}">
                        <Grid.OpacityMask>
                            <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{Binding ElementName=PART_ETextBoxRoot}"/>
                        </Grid.OpacityMask>
                        <controls:EHeaderControl HeaderPlacement="{TemplateBinding HeaderPlacement}" Header="{TemplateBinding Header}" HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                 HorizontalAlignment="{TemplateBinding HorizontalAlignment}" HorizontalContentAlignment="{TemplateBinding HorizontalAlignment}">
                            <Grid x:Name="PART_ContentContainer">
                                <Border x:Name="PART_DecorationBorder" BorderThickness="{TemplateBinding EBorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding EBorderCornerRadius}">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Foreground="Red"/>
                                        <TextBlock x:Name="PART_NoticeText" Text="{TemplateBinding NoticeInfo}" IsHitTestVisible="False" Margin="3,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""/>
                                                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_SuggestionPopup" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" VerticalOffset="2" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="Transparent">
                                        <controls:EListBox x:Name="PART_SuggestionListBox" Margin="0,0,5,5" 
                                                       IsMoveButtonVisibile="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarMargin="0,0,0,3.5"
                                                       MaxHeight="150" ItemPadding="5,2" Padding="2,2,2,-4" ItemMargin="0,-1.5,-2,-1.5" ItemBorderCornerRadius="0" SelectedItemLineWidth="0" ItemBorderThickness="0" EBorderThickness="1">
                                            <controls:EListBox.Effect>
                                                <DropShadowEffect BlurRadius="4" Opacity="0.3" Direction="315" Color="Black"/>
                                            </controls:EListBox.Effect>
                                        </controls:EListBox>
                                    </Border>
                                    
                                </Popup>
                            </Grid>
                        </controls:EHeaderControl>
                        <ext:StateListener.Rules>
                            <ext:RuleCollection>
                                <ext:Rule Target="{Binding ElementName=PART_DecorationBorder}" StateMap="
                                          MouseOut=>Back=BC, Border=PR;
                                          MouseIn=>Back=Lerp(BC,SE,0.1), Border=SE;
                                          MouseDown=>Back=Lerp(BC,SE,0.2), Border=Lerp(SE,BC,0.4);"/>
                                <ext:Rule Target="{Binding ElementName=PART_NoticeText}" StateMap="MouseOut=>Fore=Lerp(FT,BC,0.5)"/>
                            </ext:RuleCollection>
                        </ext:StateListener.Rules>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ETextBox_BoldLineStyle" 
           TargetType="{x:Type controls:ETextBox}" BasedOn="{StaticResource {x:Type controls:ETextBox}}">
        <Style.Setters>
            <Setter Property="BorderThickness" Value="2"/>
        </Style.Setters>
    </Style>
    <Style x:Key="ETextBox_RoundStyle" 
           TargetType="{x:Type controls:ETextBox}" BasedOn="{StaticResource {x:Type controls:ETextBox}}">
        <Style.Setters>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="EBorderCornerRadius" Value="{Binding ActualHeight, Converter={StaticResource CommonModifyConverter}, ConverterParameter=LTRB_L0.5+-1, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Background" Value="{Binding PrimaryBrush, RelativeSource={RelativeSource Self}}"/>
        </Style.Setters>
    </Style>
</ResourceDictionary>