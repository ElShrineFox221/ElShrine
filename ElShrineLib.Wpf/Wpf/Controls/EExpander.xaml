<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions">
  <Style TargetType="controls:EExpander">
    <Setter Property="Padding" Value="2"/>
    <Setter Property="ArrowMargin" Value="5"/>
    <Setter Property="EBorderThickness" Value="1"/>
    <Setter Property="EBorderCornerRadius" Value="2"/>
    <Setter Property="ArrowPlacement" Value="Right"/>
    <Setter Property="HeaderPlacement" Value="Top"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:EExpander">
          <Border x:Name="PART_EExpanderRoot" 
                            Background="{TemplateBinding BackBrush}" 
                            CornerRadius="{TemplateBinding EBorderCornerRadius}" 
                            BorderThickness="{TemplateBinding EBorderThickness}" 
                            Padding="{TemplateBinding Padding}" ext:StateListener.Listener="{Binding RelativeSource={RelativeSource AncestorType=controls:EExpander}}">
            <controls:EHeaderControl HeaderPlacement="{TemplateBinding HeaderPlacement}">
              <controls:EHeaderControl.Header>
                <ToggleButton x:Name="PART_HeaderBtn" 
IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" 
Background="Transparent" Style="{StaticResource ToggleButton_EmptyStyle}">
                  <Grid Margin="{TemplateBinding Padding}">
                    <controls:EHeaderControl HeaderPlacement="{TemplateBinding ArrowPlacement}"
                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                   VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                   Content="{TemplateBinding Header}" HeaderTemplate="{TemplateBinding HeaderTemplate}">
                      <controls:EHeaderControl.Header>
                        <controls:EArrowControl x:Name="PART_ArrowContainer" Grid.Row="0" Grid.Column="0" 
                          ArrowTargetAngle="{Binding HeaderPlacement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PlacementAngleConverter}, ConverterParameter=+180}"
                          ArrowBasicAngle="{Binding ArrowPlacement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PlacementAngleConverter}, ConverterParameter=+180}"
                          Foreground="{Binding BorderBrush, ElementName=PART_EExpanderRoot}"/>
                      </controls:EHeaderControl.Header>
                    </controls:EHeaderControl>
                  </Grid>
                </ToggleButton>
              </controls:EHeaderControl.Header>
              <ContentPresenter x:Name="PART_ContentHost" Grid.Row="1" Grid.Column="0" 
                                 Margin="{TemplateBinding Padding}" ContentSource="Content" RenderTransformOrigin="0,0" Visibility="Collapsed"/>
            </controls:EHeaderControl>
            <ext:StateListener.Rules>
              <ext:RuleCollection>
                <ext:Rule Target="{Binding ElementName=PART_EExpanderRoot}" StateMap="MouseOut=>Border=PR;MouseIn=>Border=SE"/>
              </ext:RuleCollection>
            </ext:StateListener.Rules>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>