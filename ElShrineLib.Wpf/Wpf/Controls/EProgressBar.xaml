<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:themes="clr-namespace:ElShrine.Wpf.UITheme"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions"
                    xmlns:converters="clr-namespace:ElShrine.Wpf.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ControlTemplate x:Key="EProgressBar_CircularTemplate" TargetType="{x:Type controls:EProgressBar}">
        <ControlTemplate.Resources>
            <sys:Double x:Key="Value1">1.0</sys:Double>
            <sys:Double x:Key="CirInterminateBarAngleRatio">0.3</sys:Double>
            <sys:Double x:Key="Angle270">270.0</sys:Double>
            <sys:Double x:Key="Angle360">360.0</sys:Double>
            <controls:EProgressBarAnimationValueCoverter x:Key="EProgressBarAnimationValueCoverter"/>
        </ControlTemplate.Resources>
        <Border x:Name="PART_EProgressBarRoot" 
                ext:ColorTransN.StateMap="
                Normal=Border:BR;
                MouseIn=Border:SE" Background="Transparent">
            <Border.OpacityMask>
                <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{Binding ElementName=PART_EProgressBarRoot}"/>
            </Border.OpacityMask>
            <Grid x:Name="PART_CircularProgress" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid HorizontalAlignment="Center">
                    <Grid.Height>
                        <MultiBinding Converter="{StaticResource NumToStringMultiConverter}" ConverterParameter="min">
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                        </MultiBinding>
                    </Grid.Height>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource NumToStringMultiConverter}" ConverterParameter="min">
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                        </MultiBinding>
                    </Grid.Width>
                    <Path x:Name="PART_CircularIndicatorBackground"
                          StrokeThickness="{TemplateBinding RingThickness}">
                        <Path.Stroke>
                            <MultiBinding Converter="{StaticResource ColorLerpToSolidBrushConverter}">
                                <Binding Path="BorderBrush" ElementName="PART_EProgressBarRoot"/>
                                <Binding Source="0.8"/>
                                <Binding Path="BackBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </MultiBinding>
                        </Path.Stroke>
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource CircularProgressToPathConverter}" ConverterParameter="rwidth">
                                <Binding Source="{StaticResource Value1}"/>
                                <Binding Path="ActualHeight" ElementName="PART_CircularProgress" Converter="{StaticResource NumToStringConverter}" ConverterParameter="0.5"/>
                                <Binding Path="RingThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding Source="{StaticResource Angle270}"/>
                                <Binding Source="{StaticResource Angle360}"/>
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                    <Path x:Name="PART_CircularIndicator"
                          Stroke="{Binding ElementName=PART_EProgressBarRoot, Path=BorderBrush}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="{TemplateBinding RingThickness}">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource CircularProgressToPathConverter}" ConverterParameter="rwidth">
                                <Binding Path="AnimatedProgress" RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding Path="ActualHeight" ElementName="PART_CircularProgress" Converter="{StaticResource NumToStringConverter}" ConverterParameter="0.5"/>
                                <Binding Path="RingThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding Source="{StaticResource Angle270}"/>
                                <Binding Source="{StaticResource Angle360}"/>
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                </Grid>
                <ContentPresenter x:Name="PART_ContentContainer" 
                                  Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_CircularIndicator" Property="Opacity">
                    <Setter.Value>
                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="TransXNorm" Converter="{StaticResource NumToStringConverter}" ConverterParameter="sinease"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PART_CircularIndicator" Property="Data">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource CircularProgressToPathConverter}" ConverterParameter="rwidth">
                            <Binding Source="{StaticResource CirInterminateBarAngleRatio}"/>
                            <Binding Path="ActualHeight" ElementName="PART_CircularProgress" Converter="{StaticResource NumToStringConverter}" ConverterParameter="0.5"/>
                            <Binding Path="RingThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                            <Binding Path="TransXNorm" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource NumToStringConverter}" ConverterParameter="{StaticResource Angle360}"/>
                            <Binding Path="TransXNorm" RelativeSource="{RelativeSource TemplatedParent}" Converter="{StaticResource NumToStringConverter}" ConverterParameter="{StaticResource Angle360}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="EProgressBar_HorizontalTemplate" TargetType="{x:Type controls:EProgressBar}">
        <ControlTemplate.Resources>
            <controls:EProgressBarAnimationValueCoverter x:Key="EProgressBarAnimationValueCoverter"/>
        </ControlTemplate.Resources>
        <Grid x:Name="PART_EProgressBarRoot">
            <Grid.OpacityMask>
                <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{Binding ElementName=PART_EProgressBarRoot}"/>
            </Grid.OpacityMask>
            <Border x:Name="PART_Background" CornerRadius="{TemplateBinding EBorderCornerRadius}" BorderThickness="0"
                    ext:ColorTransN.StateMap="
                    Normal=Back:Lerp(BG, BR, 0.2),Border:BR;
                    MouseIn=Back:Lerp(BG, SE, 0.1), Border:SE;">
                <Grid>
                    <Border x:Name="PART_ProgressIndicator" 
                            HorizontalAlignment="Left" CornerRadius="{TemplateBinding EBorderCornerRadius}" Background="{Binding ElementName=PART_Background, Path=BorderBrush}" IsHitTestVisible="False">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource NumToStringConverter}" ConverterParameter="1">
                                <Binding Source="0"/>
                                <Binding Path="AnimatedProgress" RelativeSource="{RelativeSource TemplatedParent}" />
                                <Binding ElementName="PART_Background" Path="ActualWidth" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                    <ContentPresenter x:Name="PART_ContentContainer"
                                      Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers> 
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_ProgressIndicator" Property="Opacity">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource EProgressBarAnimationValueCoverter}" ConverterParameter="opacity">
                            <Binding Path="ActualWidth" ElementName="PART_Background" />
                            <Binding Path="TransXNorm" RelativeSource="{RelativeSource TemplatedParent}"/>
                            <Binding Source="0.3"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PART_ProgressIndicator" Property="Width">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource EProgressBarAnimationValueCoverter}" ConverterParameter="width">
                            <Binding Path="ActualWidth" ElementName="PART_Background" />
                            <Binding Path="TransXNorm" RelativeSource="{RelativeSource TemplatedParent}"/>
                            <Binding Source="0.3"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PART_ProgressIndicator" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource EProgressBarAnimationValueCoverter}" ConverterParameter="x">
                                    <Binding Path="ActualWidth" ElementName="PART_Background" />
                                    <Binding Path="TransXNorm" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Source="0.3"/>
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type controls:EProgressBar}">
        <Setter Property="EBorderThickness" Value="0"/>
        <Setter Property="EBorderCornerRadius" Value="5"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsIndeterminate" Value="False"/>
        <Setter Property="RingThickness" Value="5"/>
        <Setter Property="Template" Value="{StaticResource EProgressBar_HorizontalTemplate}"/>
        <Style.Triggers>
            <Trigger Property="ProgressBarStyle" Value="Circular">
                <Setter Property="Template" Value="{StaticResource EProgressBar_CircularTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>