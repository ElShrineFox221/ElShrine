<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:extensions="clr-namespace:ElShrine.Wpf.Controls.Extensions"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <Style TargetType="controls:EInWindowDialog">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EInWindowDialog">
                    <Canvas>
                        <Grid x:Name="overlayRoot" Panel.ZIndex="10000" Visibility="Collapsed" Background="Transparent">
                            <Border x:Name="overlayMask"  Background="#80000000"  Opacity="0" BorderThickness="5" BorderBrush="Red">
                                <ContentPresenter x:Name="DialogContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Content="{TemplateBinding Content}">
                                    <ContentPresenter.RenderTransform>
                                        <ScaleTransform x:Name="contentScaleTransform" ScaleX="0.8" ScaleY="0.8"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>