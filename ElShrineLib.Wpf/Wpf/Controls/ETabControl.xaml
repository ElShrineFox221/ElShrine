<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:extensions="clr-namespace:ElShrine.Wpf.Controls.Extensions">
    <Style TargetType="{x:Type controls:ETabControl}">
        <Setter Property="TabStripPlacement" Value="Top"/>
        <Setter Property="HorizontalHeaderAlignment" Value="Stretch"/>
        <Setter Property="BorderCornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="{Binding CurrentTheme.BorderColor, Source={StaticResource ThemeProvider}, Converter={StaticResource ColorToSolidBrushConverter}}"/>
        <Setter Property="SelectionBrush" Value="{Binding CurrentTheme.SelectionColor, Source={StaticResource ThemeProvider}, Converter={StaticResource ColorToSolidBrushConverter}}"/>
        <Setter Property="ClickBrush" Value="{Binding CurrentTheme.ClickColor, Source={StaticResource ThemeProvider}, Converter={StaticResource ColorToSolidBrushConverter}}"/>
        <Setter Property="Foreground" Value="{Binding CurrentTheme.ForeColor, Source={StaticResource ThemeProvider}, Converter={StaticResource ColorToSolidBrushConverter}}"/>
        <Setter Property="Background" Value="{Binding CurrentTheme.BackColor, Source={StaticResource ThemeProvider}, Converter={StaticResource ColorToSolidBrushConverter}}"/>
        <Setter Property="FontSize" Value="{Binding CurrentTheme.FontSizeNormal, Source={StaticResource ThemeProvider}}"/>
        <Setter Property="FontBrush" Value="{Binding CurrentTheme.FontColor, Source={StaticResource ThemeProvider}, Converter={StaticResource ColorToSolidBrushConverter}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ETabControl}">
                    <Border x:Name="controlRoot" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="c0" Width="*"/>
                                <ColumnDefinition x:Name="c1" Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="r0" Height="auto"/>
                                <RowDefinition x:Name="r1" Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:ETabPannel x:Name="headerContainer" IsItemsHost="True" Grid.Row="0" HorizontalAlignment="{TemplateBinding HorizontalHeaderAlignment}" VerticalAlignment="{TemplateBinding VerticalHeaderAlignment}" Background="{TemplateBinding Background}"/>
                            <Border x:Name="contentContainer" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Grid.Column="0" Grid.Row="1" Margin="{TemplateBinding Padding}"
                                      KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
                                    <Image x:Name="snapshotContainer" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Margin="0"/>
                                    <ContentPresenter x:Name="currentContentContainer" ContentSource="SelectedContent" Margin="0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="controlRoot"
Storyboard.TargetProperty="Opacity" To="1"  Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="controlRoot" 
Storyboard.TargetProperty="Opacity" To="0.57" BeginTime="0:0:0.05" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Top">
                            <Setter TargetName="headerContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="contentContainer" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="headerContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="contentContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="r0" Property="Height" Value="auto"/>
                            <Setter TargetName="r1" Property="Height" Value="*"/>
                            <Setter TargetName="c0" Property="Width" Value="*"/>
                            <Setter TargetName="c1" Property="Width" Value="auto"/>
                            <Setter TargetName="headerContainer" Property="IsHorizontal" Value="True"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="headerContainer" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="contentContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="headerContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="contentContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="r0" Property="Height" Value="*"/>
                            <Setter TargetName="r1" Property="Height" Value="auto"/>
                            <Setter TargetName="c0" Property="Width" Value="*"/>
                            <Setter TargetName="c1" Property="Width" Value="auto"/>
                            <Setter TargetName="headerContainer" Property="IsHorizontal" Value="True"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="headerContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="contentContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="headerContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="contentContainer" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="r0" Property="Height" Value="*"/>
                            <Setter TargetName="r1" Property="Height" Value="auto"/>
                            <Setter TargetName="c0" Property="Width" Value="auto"/>
                            <Setter TargetName="c1" Property="Width" Value="*"/>
                            <Setter TargetName="headerContainer" Property="IsHorizontal" Value="False"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="headerContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="contentContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="headerContainer" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="contentContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="r0" Property="Height" Value="*"/>
                            <Setter TargetName="r1" Property="Height" Value="auto"/>
                            <Setter TargetName="c0" Property="Width" Value="*"/>
                            <Setter TargetName="c1" Property="Width" Value="auto"/>
                            <Setter TargetName="headerContainer" Property="IsHorizontal" Value="False"/>
                        </Trigger>
                        
                        <!--#region Top-->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L0|T_T0|R_R1|B_B1}"/>
                            <Setter TargetName="contentContainer" Property="BorderThickness" 
            Value="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Left -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Left"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Right -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Right"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T0|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                        <!--#region Bottom -->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B0}"/>
                            <Setter TargetName="contentContainer" Property="BorderThickness" 
            Value="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B0}"/>
                        </MultiTrigger>
                        <!-- Left -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Left"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B0}"/>
                        </MultiTrigger>
                        <!-- Right -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Right"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B1}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                        <!--#region Left -->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B0}"/>
                            <Setter TargetName="contentContainer" Property="BorderThickness" 
            Value="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Top -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Top"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Bottom -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Bottom"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B0}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                        <!--#region Right -->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T0|R_R0|B_B1}"/>
                            <Setter TargetName="contentContainer" Property="BorderThickness" 
            Value="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B1}"/>
                        </MultiTrigger>
                        <!-- Top -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Top"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T0|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Bottom -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Bottom"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B1}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="contentContainer" Property="CornerRadius" 
            Value="{Binding BorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource QuadruplesConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="controlRoot" CornerRadius="0" BorderThickness="0" Padding="{TemplateBinding Padding}" Margin="0">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource ColorLerpToSolidBrushConverter}">
                                            <Binding Path="BorderBrush" RelativeSource="{RelativeSource AncestorType=controls:ETabControl}"/>
                                            <Binding Path="(extensions:AnimationProperitiesExtension.ForeColorRate)" ElementName="controlRoot"/>
                                            <Binding Path="SelectionBrush" RelativeSource="{RelativeSource AncestorType=controls:ETabControl}"/>
                                            <Binding Path="(extensions:AnimationProperitiesExtension.BackColorRate)" ElementName="controlRoot"/>
                                            <Binding Path="Background" RelativeSource="{RelativeSource AncestorType=controls:ETabControl}"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <ContentPresenter x:Name="Content" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center" MinHeight="{Binding HorizontalHeaderPannelHeight,RelativeSource={RelativeSource AncestorType=controls:ETabControl}}" MinWidth="{Binding VerticalHeaderPannelWidth,RelativeSource={RelativeSource AncestorType=controls:ETabControl}}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="controlRoot"
Storyboard.TargetProperty="Opacity" To="1"  Duration="0:0:0.16">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="controlRoot" 
Storyboard.TargetProperty="Opacity" To="0.57" BeginTime="0:0:0.05" Duration="0:0:0.16">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard HandoffBehavior="Compose">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="controlRoot" To="1" Duration="0:0:0.2" Storyboard.TargetProperty="(extensions:AnimationProperitiesExtension.ForeColorRate)">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard HandoffBehavior="Compose">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="controlRoot" To="0" Duration="0:0:0.2" Storyboard.TargetProperty="(extensions:AnimationProperitiesExtension.ForeColorRate)">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard HandoffBehavior="Compose">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="controlRoot" To="0.5" Duration="0:0:0.2" Storyboard.TargetProperty="(extensions:AnimationProperitiesExtension.BackColorRate)">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard HandoffBehavior="Compose">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="controlRoot" To="0" Duration="0:0:0.2" Storyboard.TargetProperty="(extensions:AnimationProperitiesExtension.BackColorRate)">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>