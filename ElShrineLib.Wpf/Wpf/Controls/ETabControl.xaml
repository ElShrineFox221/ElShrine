<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions"
                    xmlns:converters="clr-namespace:ElShrine.Wpf.Converters">
    <Style TargetType="{x:Type controls:ETabControl}">
        <Style.Resources>
            <converters:CommonModifyConverter x:Key="CommonModifyConverter"/>
        </Style.Resources>
        <Setter Property="TabStripPlacement" Value="Top"/>
        <Setter Property="HorizontalHeaderAlignment" Value="Left"/>
        <Setter Property="EBorderThickness" Value="1"/>
        <Setter Property="EBorderCornerRadius" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ETabControl}">
                    <Border x:Name="PART_ETabControlRoot" BorderThickness="0" ext:StateListener.Listener="{Binding RelativeSource={RelativeSource AncestorType=controls:ETabControl}}" Background="Transparent">
                        <Border.OpacityMask>
                            <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{x:Reference PART_ETabControlRoot}"/>
                        </Border.OpacityMask>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="c0" Width="*"/>
                                <ColumnDefinition x:Name="c1" Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="r0" Height="auto"/>
                                <RowDefinition x:Name="r1" Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:ETabPannel x:Name="PART_HeadersContainer" IsItemsHost="True" Grid.Row="0" 
                                                 HorizontalAlignment="{TemplateBinding HorizontalHeaderAlignment}" 
                                                 VerticalAlignment="{TemplateBinding VerticalHeaderAlignment}" 
                                                 Background="{TemplateBinding BackBrush}"/>
                            <Border x:Name="PART_ContentContainer" 
                                    Background="{TemplateBinding BackBrush}" 
                                    BorderThickness="{TemplateBinding EBorderThickness}" ClipToBounds="True">
                                <Grid Grid.Column="0" Grid.Row="1" Margin="{TemplateBinding Padding}"
                                      KeyboardNavigation.DirectionalNavigation="Contained" 
                                      KeyboardNavigation.TabNavigation="Local" 
                                      KeyboardNavigation.TabIndex="2">
                                    <ContentPresenter x:Name="PART_CurrentContentContainer" ContentSource="SelectedContent" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <Image x:Name="PART_SnapshotContainer" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" Margin="0"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ext:StateListener.Rules>
                            <ext:RuleCollection>
                                <ext:Rule Target="{Binding ElementName=PART_ContentContainer}" StateMap="MouseOut=>Border=PR;MouseIn=>Border=SE;"/>
                            </ext:RuleCollection>
                        </ext:StateListener.Rules>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Top">
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="r0" Property="Height" Value="auto"/>
                            <Setter TargetName="r1" Property="Height" Value="*"/>
                            <Setter TargetName="c0" Property="Width" Value="*"/>
                            <Setter TargetName="c1" Property="Width" Value="auto"/>
                            <Setter TargetName="PART_HeadersContainer" Property="IsHorizontal" Value="True"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="r0" Property="Height" Value="*"/>
                            <Setter TargetName="r1" Property="Height" Value="auto"/>
                            <Setter TargetName="c0" Property="Width" Value="*"/>
                            <Setter TargetName="c1" Property="Width" Value="auto"/>
                            <Setter TargetName="PART_HeadersContainer" Property="IsHorizontal" Value="True"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="r0" Property="Height" Value="*"/>
                            <Setter TargetName="r1" Property="Height" Value="auto"/>
                            <Setter TargetName="c0" Property="Width" Value="auto"/>
                            <Setter TargetName="c1" Property="Width" Value="*"/>
                            <Setter TargetName="PART_HeadersContainer" Property="IsHorizontal" Value="False"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="PART_HeadersContainer" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_ContentContainer" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="r0" Property="Height" Value="*"/>
                            <Setter TargetName="r1" Property="Height" Value="auto"/>
                            <Setter TargetName="c0" Property="Width" Value="*"/>
                            <Setter TargetName="c1" Property="Width" Value="auto"/>
                            <Setter TargetName="PART_HeadersContainer" Property="IsHorizontal" Value="False"/>
                        </Trigger>
                        
                        <!--#region Top-->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L0|T_T0|R_R1|B_B1}"/>
                            <Setter TargetName="PART_ContentContainer" Property="BorderThickness" 
            Value="{Binding EBorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Left -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Left"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Right -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Right"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T0|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Top"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                        <!--#region Bottom -->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B0}"/>
                            <Setter TargetName="PART_ContentContainer" Property="BorderThickness" 
            Value="{Binding EBorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B0}"/>
                        </MultiTrigger>
                        <!-- Left -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Left"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B0}"/>
                        </MultiTrigger>
                        <!-- Right -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Right"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B1}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Bottom"/>
                                <Condition Property="HorizontalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                        <!--#region Left -->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B0}"/>
                            <Setter TargetName="PART_ContentContainer" Property="BorderThickness" 
            Value="{Binding EBorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Top -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Top"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L0|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Bottom -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Bottom"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B0}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Left"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                        <!--#region Right -->
                        <!-- Stretch -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Stretch"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T0|R_R0|B_B1}"/>
                            <Setter TargetName="PART_ContentContainer" Property="BorderThickness" 
            Value="{Binding EBorderThickness, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B1}"/>
                        </MultiTrigger>
                        <!-- Top -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Top"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T0|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!-- Bottom -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Bottom"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R0|B_B1}"/>
                        </MultiTrigger>
                        <!-- Center -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="TabStripPlacement" Value="Right"/>
                                <Condition Property="VerticalHeaderAlignment" Value="Center"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ContentContainer" Property="CornerRadius" 
            Value="{Binding EBorderCornerRadius, RelativeSource={RelativeSource TemplatedParent}, 
                   Converter={StaticResource CommonModifyConverter}, 
                   ConverterParameter=L_L1|T_T1|R_R1|B_B1}"/>
                        </MultiTrigger>
                        <!--#endregion-->
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Background="Transparent">
                        <ContentControl Content="{Binding}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="PART_TabItemRoot" 
                                        BorderThickness="0" Background="Transparent">
                                    <controls:ESelectedIndicator EBorderThickness="0" IndicatorPlacement="Down" 
                                                                 IsSelected="{TemplateBinding IsSelected}"
                                                                 EBorderCornerRadius="{Binding RelativeSource={RelativeSource AncestorType=controls:ETabControl},Path=EBorderCornerRadius,Converter={StaticResource CommonModifyConverter},ConverterParameter=L_L1|T_T1}" >
                                        <ContentPresenter x:Name="Content" ContentSource="Header" RecognizesAccessKey="True" 
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"
                                                          MinHeight="{Binding HorizontalHeaderPannelHeight,RelativeSource={RelativeSource AncestorType=controls:ETabControl}}" 
                                                          MinWidth="{Binding VerticalHeaderPannelWidth,RelativeSource={RelativeSource AncestorType=controls:ETabControl}}"/>
                                    </controls:ESelectedIndicator>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>