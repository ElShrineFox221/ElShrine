<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions"
                    xmlns:converters="clr-namespace:ElShrine.Wpf.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ControlTemplate x:Key="EImage_BaseTemplate" TargetType="controls:EImage">
        <Grid x:Name="PART_EImageRoot">
            <Grid.OpacityMask>
                <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{Binding ElementName=PART_EImageRoot}"/>
            </Grid.OpacityMask>
            <Grid Margin="{TemplateBinding Padding}">
                <Image x:Name="PART_Image" 
                       Margin="0" Source="{TemplateBinding LoadedImageSource}" Stretch="{TemplateBinding Stretch}" Visibility="Visible"/>
            </Grid>
            <Border x:Name="PART_Background" 
                    BorderThickness="{TemplateBinding EBorderThickness}" CornerRadius="{TemplateBinding EBorderCornerRadius}" Padding="{TemplateBinding Padding}"
                    ext:ColorTransN.StateMap="
                    Normal=Border:BR;
                    MouseIn=Border:SE;" Background="Transparent">
                <Grid>
                    <Grid x:Name="PART_LoadingOverlay" Background="#4A000000" Visibility="Collapsed">
                        <controls:EProgressBar x:Name="PART_ProgressBar" 
                           MaxHeight="100" Margin="10" ProgressBarStyle="Circular">
                            <controls:EButton Background="Transparent" BorderThickness="0" Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Cancel}" Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Cancel.TranslatedText}"/>
                        </controls:EProgressBar>
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="PART_ErrorNoticeOverlay" 
                                Grid.Row="1" Padding="2" CornerRadius="5" Visibility="Collapsed" Margin="10" BorderBrush="Transparent">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource ColorLerpToSolidBrushConverter}" ConverterParameter="alpha.lerp">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="BackBrush"/>
                                    <Binding Source="0.4"/>
                                    <Binding RelativeSource="{RelativeSource Self}" Path="BorderBrush"/>
                                </MultiBinding>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="5" Text="{TemplateBinding ErrorMsg}" Foreground="Red" VerticalAlignment="Center" TextWrapping="Wrap" MinWidth="10" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                <controls:EButton Grid.Column="1" 
                                                  Margin="5" 
                                                  Command="{x:Static controls:EImage.RetryDefault}" 
                                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  IsEnabled="{Binding Source={x:Static controls:EImage.RetryDefault}, Path=IsRunning, Converter={StaticResource BoolReverseConverter}}" 
                                                  MaxHeight="24" EBorderThickness="0" EBorderCornerRadius="4" BackBrush="White" Padding="5,2">
                                    <controls:EButton.Content>
                                        <TextBlock Text="&#xE777;" Foreground="{Binding ElementName=PART_Background, Path=BorderBrush}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </controls:EButton.Content>
                                </controls:EButton>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type controls:EImage}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="EBorderThickness" Value="3"/>
        <Setter Property="EBorderCornerRadius" Value="5"/>
        <Setter Property="Padding" Value="2.5"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Template" Value="{StaticResource EImage_BaseTemplate}"/>
    </Style>
    
    <ControlTemplate x:Key="EImage_SimpleTemplate" TargetType="controls:EImage">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
        </ControlTemplate.Resources>
        <Grid x:Name="PART_EImageRoot">
            <Grid.OpacityMask>
                <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{Binding ElementName=PART_EImageRoot}"/>
            </Grid.OpacityMask>
            <Grid Margin="{TemplateBinding Padding}">
                <Image x:Name="PART_Image"
   Margin="0" Source="{TemplateBinding LoadedImageSource}" Stretch="{TemplateBinding Stretch}" Visibility="Visible"/>
            </Grid>
            <Border x:Name="PART_Background" 
                BorderThickness="{TemplateBinding EBorderThickness}" CornerRadius="{TemplateBinding EBorderCornerRadius}" Padding="{TemplateBinding Padding}"
                ext:ColorTransN.StateMap="
                Normal=Border:BR;
                MouseIn=Border:SE;" Background="Transparent">
                <Grid>
                    <Grid x:Name="PART_LoadingOverlay" Background="#4A000000" Visibility="Collapsed"/>
                    <controls:EButton x:Name="PART_ErrorNoticeOverlay" 
                                      Margin="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                      Command="{x:Static controls:EImage.RetryDefault}" 
                                      CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                      IsEnabled="{Binding Source={x:Static controls:EImage.RetryDefault}, Path=IsRunning, Converter={StaticResource BoolReverseConverter}}" 
                                      EBorderThickness="0" EBorderCornerRadius="{TemplateBinding EBorderCornerRadius}"
                                      MaxHeight="40" MaxWidth="40" FontSize="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth, Converter={StaticResource NumToStringConverter}, ConverterParameter=0.5}">
                        <controls:EButton.BackBrush>
                            <MultiBinding Converter="{StaticResource ColorLerpToSolidBrushConverter}" ConverterParameter="alpha.lerp">
                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="BackBrush"/>
                                <Binding Source="0.3"/>
                                <Binding Source="{StaticResource TransparentBrush}"/>
                            </MultiBinding>
                        </controls:EButton.BackBrush>
                        <controls:EButton.Content>
                            <TextBlock Text="&#xE777;" Foreground="{Binding ElementName=PART_Background, Path=BorderBrush}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </controls:EButton.Content>
                        <controls:EButton.ToolTip>
                            <TextBlock Margin="5" Text="{TemplateBinding ErrorMsg}" Foreground="Red" VerticalAlignment="Center" TextWrapping="Wrap" MinWidth="10" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        </controls:EButton.ToolTip>
                    </controls:EButton>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>
    <Style x:Key="EImage_SimpleStyle" TargetType="controls:EImage" BasedOn="{StaticResource {x:Type controls:EImage}}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="EBorderThickness" Value="0"/>
        <Setter Property="EBorderCornerRadius" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Template" Value="{StaticResource EImage_SimpleTemplate}"/>
    </Style> 
</ResourceDictionary>