<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions">
    <Style TargetType="{x:Type controls:EArrowControl}">
        <Style.Setters>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:EArrowControl}">
                        <Border x:Name="PART_ArrowControlRoot" Grid.Row="0" Grid.Column="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Height="{TemplateBinding ArrowSize}" Width="{TemplateBinding ArrowSize}"
                                Margin="{TemplateBinding ArrowMargin}" Background="Transparent">
                            <Viewbox RenderTransformOrigin="0.5,0.5">
                                <Path x:Name="PART_Arrow" Width="11" Height="6" Stretch="Uniform" Data="M0,0 L5,5 L10,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" >
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="PART_ArrowRotateTransform" CenterX="5" CenterY="3" Angle="90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
</ResourceDictionary>