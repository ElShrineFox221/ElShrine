<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions">
    <ControlTemplate x:Key="EButton_BaseTemplate" TargetType="controls:EButton">
        <Grid x:Name="PART_EButtonRoot" ext:StateListener.Listener="{Binding RelativeSource={RelativeSource AncestorType=controls:EButton}}">
            <Grid.OpacityMask>
                <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{x:Reference PART_EButtonRoot}"/>
            </Grid.OpacityMask>
            <Border x:Name="PART_MainBorder" BorderThickness="{TemplateBinding EBorderThickness}" CornerRadius="{TemplateBinding EBorderCornerRadius}" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="HighQuality" TextOptions.TextFormattingMode="Ideal">
                <ContentControl x:Name="PART_ContentContainer"
                                Foreground="{TemplateBinding FontBrush}" Background="Transparent" Margin="{TemplateBinding Padding}" >
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </ContentControl>
            </Border>
            <controls:ScaleController ScaleTarget="{Binding ElementName=PART_RootScaleTransform}" 
                                      Scale="{TemplateBinding ClickShakeScale}" 
                                      BeTriggered="{Binding RelativeSource={RelativeSource AncestorType=controls:EButton}, Path=IsPressed}" 
                                      IsEnabled="{TemplateBinding IsClickShakable}" IsShakeMode="False"/>
            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PART_RootScaleTransform"/>
            </Grid.RenderTransform>
            <ext:StateListener.Rules>
                <ext:RuleCollection>
                    <ext:Rule Target="{Binding ElementName=PART_MainBorder}" StateMap="
                              MouseOut=>Back=BC, Border=PR;
                              MouseIn=>Back=Lerp(BC, SE, 0.1), Border=SE;
                              MouseDown=>Back=Lerp(BC, SE, 0.2)"/>
                </ext:RuleCollection>
            </ext:StateListener.Rules>
        </Grid>
    </ControlTemplate>
    <Style TargetType="controls:EButton">
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="EBorderThickness" Value="1"/>
        <Setter Property="EBorderCornerRadius" Value="2"/>
        <Setter Property="Template" Value="{StaticResource EButton_BaseTemplate}"/>
    </Style>
    
    <ControlTemplate x:Key="EButton_BackColorTemplate" TargetType="controls:EButton">
        <Grid x:Name="PART_EButtonRoot" ext:StateListener.Listener="{Binding RelativeSource={RelativeSource AncestorType=controls:EButton}}">
            <Grid.OpacityMask>
                <SolidColorBrush Color="Black" ext:EnabledTrans.EnabledSource="{x:Reference PART_EButtonRoot}"/>
            </Grid.OpacityMask>
            <Border x:Name="PART_MainBorder" BorderThickness="0" CornerRadius="{TemplateBinding EBorderCornerRadius}" CacheMode="BitmapCache">
                <ContentControl x:Name="PART_ContentContainer"
                            Foreground="{TemplateBinding BackBrush}" Background="Transparent" Margin="{TemplateBinding Padding}" >
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </ContentControl>
            </Border>
            <controls:ScaleController ScaleTarget="{Binding ElementName=PART_RootScaleTransform}" 
                           Scale="{TemplateBinding ClickShakeScale}" 
                           BeTriggered="{Binding RelativeSource={RelativeSource AncestorType=controls:EButton}, Path=IsPressed}" 
                           IsEnabled="{TemplateBinding IsClickShakable}" IsShakeMode="False"/>
            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PART_RootScaleTransform"/>
            </Grid.RenderTransform>
            <ext:StateListener.Rules>
                <ext:RuleCollection>
                    <ext:Rule Target="{Binding ElementName=PART_MainBorder}" StateMap="
                              MouseOut=>Back=PR;
                              MouseIn=>Back=Lerp(SE, BC, 0.1);
                              MouseDown=>Back=Lerp(SE, BC, 0.2)"/>
                </ext:RuleCollection>
            </ext:StateListener.Rules>
        </Grid>
    </ControlTemplate>
    <Style x:Key="EButton_BackColorStyle" TargetType="controls:EButton" BasedOn="{StaticResource {x:Type controls:EButton}}">
        <Setter Property="Template" Value="{StaticResource EButton_BackColorTemplate}"/>
    </Style>

    <Style x:Key="EButton_CircleStyle" TargetType="controls:EButton" BasedOn="{StaticResource {x:Type controls:EButton}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="MaxWidth" Value="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight}"/>
        <Setter Property="EBorderCornerRadius" Value="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={StaticResource CommonModifyConverter}, ConverterParameter=LRTB_0.5L}"/>
    </Style>
</ResourceDictionary>