<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:ext="clr-namespace:ElShrine.Wpf.Controls.Extensions">
    <Style TargetType="controls:ETreeViewItem">
        <Setter Property="ArrowMargin" Value="{Binding ArrowMargin, RelativeSource={RelativeSource AncestorType=controls:ETreeView}}"/>
        <Setter Property="IndentUnitLength" Value="{Binding IndentUnitLength, RelativeSource={RelativeSource AncestorType=controls:ETreeView}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ETreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid x:Name="PART_ContentContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" 
                                            Content="{Binding Path=DataContext, RelativeSource={RelativeSource TemplatedParent}}" 
                                            ContentTemplate="{TemplateBinding LeftColumnTemplate}"
                                            VerticalContentAlignment="Stretch" HorizontalAlignment="Stretch"/>
                            <Border x:Name="Selection_Border" Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle x:Name="PART_IndentSpacer" Width="{Binding IndentWidth, RelativeSource={RelativeSource TemplatedParent}}" Visibility='Hidden'/>
                                    <ToggleButton x:Name="Expander" 
                                                  Visibility="{Binding ItemsBtnVisibility, RelativeSource={RelativeSource TemplatedParent}}" 
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Border x:Name="arrowContainer" Grid.Row="0" Grid.Column="1" 
                                                ext:StateListener.Listener="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                Margin="{TemplateBinding ArrowMargin}" Background="Transparent">
                                            <Viewbox>
                                                <Path x:Name="PART_Arrow" Width="11" Height="6" Stretch="Uniform" Data="M0,0 L5,5 L10,0"  StrokeThickness="1.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="PART_ArrowRotateTransform" CenterX="5" CenterY="3" Angle="-90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Viewbox>
                                        </Border>
                                        <ext:StateListener.Rules>
                                            <ext:RuleCollection>
                                                <ext:Rule Target="{Binding ElementName=PART_ArrowRotateTransform}" StateMap="Selected=>Angle=0; Unselected=>Angle=-90"/>
                                                <ext:Rule Target="{Binding ElementName=PART_Arrow}" StateMap="MouseOut=>Stroke=Lerp(PR,BC,0.2); MouseIn=>Stroke=Lerp(SE,BC,0.3)"/>
                                            </ext:RuleCollection>
                                        </ext:StateListener.Rules>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"  Margin="{Binding ItemPadding, RelativeSource={RelativeSource AncestorType=controls:ETreeView}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Visibility="Collapsed"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>