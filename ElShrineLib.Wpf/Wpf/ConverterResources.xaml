<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:modules="clr-namespace:ElShrine.Modules"
                    xmlns:converters="clr-namespace:ElShrine.Wpf.Converters">
    <!--Common resources-->
    <Style x:Key="TextBlock_IconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
    <Style x:Key="RepeatButton_TransparentStyle" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="EnumComboBoxDataTemplate">
        <TextBlock Text="{Binding Converter={StaticResource EnumTextLocalizeConverter}}"/>
    </DataTemplate>
    <ObjectDataProvider x:Key="ThemeProvider" MethodName="GetInstance" ObjectType="{x:Type modules:UIThemesManager}"/>
    
    <!-- Normal converter: directly convert value to another value type-->
    <!-- only: num, color(data), bool, sign(enum), string, quadruple-->
    <converters:CommonConverter x:Key="CommonConverter"/>
    <converters:CommonModifyConverter x:Key="CommonModifyConverter"/>
    <converters:ExpressionConverter x:Key="ExpressionConverter"/>
    <!--Gemometry converters-->
    <converters:CircularProgressToPathConverter x:Key="CircularProgressToPathConverter"/>
    <!--Localization converters-->
    <converters:LocalizeConverter x:Key="LocalizeConverter"/>


    <converters:EnumTextLocalizeConverter x:Key="EnumTextLocalizeConverter"/>
    <converters:ImageSourceCoverter x:Key="ImageSourceCoverter"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
</ResourceDictionary>