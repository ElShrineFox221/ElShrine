<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ElShrine.Old.Wpf"
                    xmlns:converters="clr-namespace:ElShrine.Old.Wpf.Converters"
                    xmlns:control="clr-namespace:ElShrine.Old.Wpf.Controls">
    <!--#region ElShrine TempField Resources-->
    <ControlTemplate x:Key="ElShrineTempField_Template" TargetType="{x:Type control:ElShrineTempField}">
        <ControlTemplate.Resources>
            <converters:ThicknessToDouble x:Key="ThicknessToDouble"/>
        </ControlTemplate.Resources>
        <Border BorderBrush="Black" BorderThickness="3">
            <Grid>
                <Canvas Margin="0" Name="TempFieldContainer_Canvas">
                    
                </Canvas>
            </Grid>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="ElShrineTempFieldUnit_Template" TargetType="{x:Type control:ElShrineTempFieldUnit}">
        <ControlTemplate.Resources>
            <converters:ThicknessToDouble x:Key="ThicknessToDouble"/>
            <converters:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
        </ControlTemplate.Resources>
        <Border BorderBrush="Black" BorderThickness="3" Background="{TemplateBinding Background}">
            <Grid Visibility="{Binding Visible,Converter={StaticResource BoolToVisibleConverter},RelativeSource={RelativeSource AncestorType={x:Type control:ElShrineTempFieldUnit}}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0" Text="{Binding Distance,RelativeSource={RelativeSource AncestorType={x:Type control:ElShrineTempFieldUnit}}}"/>
                <TextBlock FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="2" Text="{Binding Cost,RelativeSource={RelativeSource AncestorType={x:Type control:ElShrineTempFieldUnit}}}"/>
                <TextBlock FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="0" Text="{Binding Value,RelativeSource={RelativeSource AncestorType={x:Type control:ElShrineTempFieldUnit}}}"/>
                <TextBlock FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1" Text="{Binding StartSign,RelativeSource={RelativeSource AncestorType={x:Type control:ElShrineTempFieldUnit}}}"/>
                <TextBlock FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1" Text="{Binding TagSign,RelativeSource={RelativeSource AncestorType={x:Type control:ElShrineTempFieldUnit}}}"/>
            </Grid>
        </Border>
    </ControlTemplate>
    <Style x:Key="ElShrineTempField_Style" TargetType="{x:Type control:ElShrineTempField}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Template" Value="{StaticResource ElShrineTempField_Template}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{Binding Option_ForeColor, Source={StaticResource OptionProvider}}"/>
    </Style>
    <Style x:Key="ElShrineTempFieldUnit_Style" TargetType="{x:Type control:ElShrineTempFieldUnit}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Template" Value="{StaticResource ElShrineTempFieldUnit_Template}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    <!--#endregion-->
</ResourceDictionary>