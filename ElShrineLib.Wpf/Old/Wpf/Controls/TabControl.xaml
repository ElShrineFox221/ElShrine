<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ElShrine.Old.Wpf"
                    xmlns:converter="clr-namespace:ElShrine.Old.Wpf.Converters"
                    xmlns:extension="clr-namespace:ElShrine.Old.Wpf.Controls.Extensions"
                    x:Class="ElShrine.View.Wpf.Drawing.Controls.ControlEvent.TabControlEvent">
    <Style x:Key="ElShrineTabItem_BaseStyle" TargetType="{x:Type TabItem}">
        <Style.Resources>
            <converter:DoubleToThickness x:Key="DoubleToThickness"/>
            <converter:ThicknessFactor x:Key="ThicknessFactor"/>
        </Style.Resources>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="{Binding Background,RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"/>
        <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"/>
        <Setter Property="BorderBrush" Value="{Binding BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="{Binding BorderThickness,RelativeSource={RelativeSource AncestorType={x:Type TabControl}},Converter={StaticResource ThicknessFactor},ConverterParameter=Max_}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <ControlTemplate.Resources>
                        <converter:ThicknessFactor x:Key="ThicknessFactor"/>
                        <converter:ToTargetColorBrush x:Key="ToTargetColorBrush"/>
                        <converter:DoubleToCornerRadius x:Key="DoubleToCornerRadius"/>
                    </ControlTemplate.Resources>
                    <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                        <Border x:Name="mainBorder" 
                                    BorderBrush="{TemplateBinding BorderBrush}" Margin="0" BorderThickness="0" CornerRadius="{TemplateBinding ActualHeight,Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0.3_T0.3_R0_B0}">
                            <Border x:Name="innerBorder" 
                                        BorderThickness="{Binding BorderThickness,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource ThicknessFactor},ConverterParameter=L1_T1_R0_B0}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{Binding CornerRadius, ElementName=mainBorder}">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource ToTargetColorBrush}" ConverterParameter="0.6">
                                        <Binding Path="Background" ElementName="contentControl"/>
                                        <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="(extension:RateExtension.BackColorRate)" ElementName="templateRoot"/>
                                    </MultiBinding>
                                </Border.Background>
                            </Border>
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource ToTargetColorBrush}" ConverterParameter="1">
                                    <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="(extension:RateExtension.ForeColorRate)" ElementName="templateRoot"/>
                                </MultiBinding>
                            </Border.Background>
                        </Border>
                        <ContentControl x:Name="contentControl" Background="Transparent">
                            <ContentControl.Foreground>
                                <MultiBinding Converter="{StaticResource ToTargetColorBrush}" ConverterParameter="1">
                                    <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="(extension:RateExtension.ForeColorRate)" ElementName="templateRoot"/>
                                </MultiBinding>
                            </ContentControl.Foreground>
                            <ContentPresenter x:Name="contentPresenter" ContentSource="Header" Focusable="False" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--#region IsEnabled-->
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!--#endregion-->
                        <!--#region TabStripPlacement-->
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="CornerRadius" TargetName="mainBorder" Value="{Binding ActualHeight,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0.3_T0_R0_B0.3}"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Top">
                            <Setter Property="CornerRadius" TargetName="mainBorder" Value="{Binding ActualHeight,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0.3_T0.3_R0_B0}"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter Property="CornerRadius" TargetName="mainBorder" Value="{Binding ActualHeight,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0_T0.3_R0.3_B0}"/>
                            <Setter Property="BorderThickness" TargetName="innerBorder" Value="{Binding BorderThickness,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource ThicknessFactor},ConverterParameter=L0_T1_R1_B0}"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter Property="CornerRadius" TargetName="mainBorder" Value="{Binding ActualHeight,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0_T0_R0.3_B0.3}"/>
                            <Setter Property="BorderThickness" TargetName="innerBorder" Value="{Binding BorderThickness,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource ThicknessFactor},ConverterParameter=L0_T0_R1_B1}"/>
                        </Trigger>
                        <!--#endregion-->
                        <!--#region IsSelected & IsMouseOver-->
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="templateRoot" Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="templateRoot" Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="templateRoot" Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="templateRoot" Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!--#endregion-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--#region TabStripPlacement-->
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter Property="Padding" Value="8,1,5,1"/>
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Top">
                <Setter Property="Padding" Value="6,2,6,-1"/>
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter Property="Padding" Value="5,1,8,1"/>
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Bottom">
                <Setter Property="Padding" Value="6,-1,6,2"/>
            </Trigger>
            <!--#endregion-->
        </Style.Triggers>
    </Style>
    <Style x:Key="ElShrineTabControl_BaseStyle" TargetType="{x:Type TabControl}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="Foreground" Value="{Binding Option_FontColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="Background" Value="{Binding Option_BackColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="BorderBrush" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ElShrineTabItem_BaseStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <ControlTemplate.Resources>
                        <converter:DoubleToCornerRadius x:Key="DoubleToCornerRadius"/>
                    </ControlTemplate.Resources>
                    <Grid x:Name="templateRoot" ClipToBounds="true" SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColumnDefinition0"/>
                            <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                            <RowDefinition x:Name="RowDefinition1" Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="headerPanel" 
                                      Background="Transparent" Grid.Column="0" IsItemsHost="true" Margin="0" Grid.Row="0" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
                        <Border x:Name="contentPanel" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local"
                                    CornerRadius="{Binding FontSize
                                ,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0_T0.7_R0.7_B0.7}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter Property="Grid.Row" TargetName="headerPanel" Value="1"/>
                            <Setter Property="Grid.Row" TargetName="contentPanel" Value="0"/>
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                            <Setter Property="Height" TargetName="RowDefinition1" Value="Auto"/>
                            <Setter Property="CornerRadius" TargetName="contentPanel" Value="{Binding FontSize
                                ,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0.7_T0.7_R0.7_B0}"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter Property="Grid.Row" TargetName="headerPanel" Value="0"/>
                            <Setter Property="Grid.Row" TargetName="contentPanel" Value="0"/>
                            <Setter Property="Grid.Column" TargetName="headerPanel" Value="0"/>
                            <Setter Property="Grid.Column" TargetName="contentPanel" Value="1"/>
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto"/>
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="*"/>
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter Property="Grid.Row" TargetName="headerPanel" Value="0"/>
                            <Setter Property="Grid.Row" TargetName="contentPanel" Value="0"/>
                            <Setter Property="Grid.Column" TargetName="headerPanel" Value="1"/>
                            <Setter Property="Grid.Column" TargetName="contentPanel" Value="0"/>
                            <Setter Property="Width" TargetName="ColumnDefinition0" Value="*"/>
                            <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto"/>
                            <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                            <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                            <Setter Property="CornerRadius" TargetName="contentPanel" Value="{Binding FontSize
                                ,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource DoubleToCornerRadius},ConverterParameter=L0.7_T0_R0.7_B0.7}"/>
                        </Trigger>
                        <!--#region IsEnabled-->
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!--#endregion-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>