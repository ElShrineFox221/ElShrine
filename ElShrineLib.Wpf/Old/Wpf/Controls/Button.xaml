<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ElShrine.Old.Wpf"
                    xmlns:converter="clr-namespace:ElShrine.Old.Wpf.Converters"
                    xmlns:extension="clr-namespace:ElShrine.Old.Wpf.Controls.Extensions">
    <Style x:Key="ElShrineButton_BaseStyle" TargetType="{x:Type Button}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ControlTemplate.Resources>
                        <converter:ThicknessToDouble x:Key="ThicknessToDouble"/>
                        <converter:ToOppsiteColorBrush x:Key="ToOppsiteColorBrush"/>
                    </ControlTemplate.Resources>
                    <Grid x:Name="rootGrid"  Margin="0" extension:RateExtension.ForeColorRate="0">
                        <Border 
                                BorderThickness="0" CornerRadius="{TemplateBinding BorderThickness, Converter={StaticResource ThicknessToDouble},ConverterParameter=1}"
                                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                    Padding="0" Margin="0">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource ToOppsiteColorBrush}" ConverterParameter="Brush_-0.4">
                                    <Binding Path="Background" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                    <Binding Path="(extension:RateExtension.BackColorRate)" ElementName="rootGrid"/>
                                </MultiBinding>
                            </Border.Background>
                        </Border>
                        <ContentControl Margin="0" 
                                            Background="Transparent">
                            <ContentControl.Foreground>
                                <MultiBinding Converter="{StaticResource ToOppsiteColorBrush}" ConverterParameter="Brush_-0.4">
                                    <Binding Path="Foreground" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                    <Binding Path="(extension:RateExtension.ForeColorRate)" ElementName="rootGrid"/>
                                </MultiBinding>
                            </ContentControl.Foreground>
                            <ContentPresenter
                                    Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </ContentControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.6" 
                                                Duration="0:0:0.08">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"  
                                                Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" 
                                                To="0"  
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="0" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{Binding Option_BackColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="Background" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="Padding" Value="7,3.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!--#endregion-->

    <!--#region UnderLine Style-->
    <Style x:Key="ElShrineButton_UnderLineStyle" TargetType="{x:Type Button}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <ControlTemplate.Resources>
                        <converter:ToOppsiteColorBrush x:Key="ToOppsiteColorBrush"/>
                        <converter:ToRequiredDouble x:Key="ToRequiredDouble"/>
                        <converter:ThicknessToDouble x:Key="ThicknessToDouble"/>
                        <converter:ThicknessFactor x:Key="ThicknessFactor"/>
                        <converter:DoubleFactor x:Key="DoubleFactor"/>
                    </ControlTemplate.Resources>
                    <Grid x:Name="rootGrid"  Margin="0" extension:RateExtension.ForeColorRate="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="rulerBorder" BorderThickness="{TemplateBinding BorderThickness}" Visibility="Hidden"/>
                        <ContentControl Margin="0" 
                                            Background="Transparent">
                            <ContentControl.Foreground>
                                <MultiBinding Converter="{StaticResource ToOppsiteColorBrush}" ConverterParameter="Brush_-0.4">
                                    <Binding Path="Foreground" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                    <Binding Path="(extension:RateExtension.ForeColorRate)" ElementName="rootGrid"/>
                                </MultiBinding>
                            </ContentControl.Foreground>
                            <ContentPresenter
                                    x:Name="buttonContentPresenter"
                                    Focusable="False" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </ContentControl>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Visibility="Hidden" Width="{Binding ActualWidth,ElementName=buttonContentPresenter,Converter={StaticResource DoubleFactor},ConverterParameter=0.05}"/>
                            <Border Grid.Column="1"
                                    Height="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessToDouble},ConverterParameter=Max_1}" BorderThickness="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessFactor},ConverterParameter=0.5}" CornerRadius="{TemplateBinding BorderThickness, Converter={StaticResource ThicknessToDouble},ConverterParameter=Max_0.25}"
                                    VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ToRequiredDouble}" ConverterParameter="Extra_0.6">
                                        <Binding Path="ActualWidth" ElementName="buttonContentPresenter"/>
                                        <Binding Path="(extension:RateExtension.UnderLineRate)" ElementName="rootGrid"/>
                                    </MultiBinding>
                                </Border.Width>
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource ToOppsiteColorBrush}" ConverterParameter="Brush_-0.4">
                                        <Binding Path="Foreground" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                        <Binding Path="(extension:RateExtension.ForeColorRate)" ElementName="rootGrid"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.6" 
                                                Duration="0:0:0.08">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.UnderLineRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <EventTrigger.Actions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"  
                                                Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" 
                                                To="0"  
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="0" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootGrid"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.UnderLineRate)" 
                                                To="0" 
                                                Duration="0:0:0.8">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="Background" Value="{Binding Option_BackColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="BorderThickness" Value="6"/>
        <Setter Property="Padding" Value="7,3.5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>