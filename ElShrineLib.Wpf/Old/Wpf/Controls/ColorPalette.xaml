<UserControl x:Class="ElShrine.Old.Wpf.Controls.ColorPalette"
             x:Name="ColorPaletteInstance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodel="clr-namespace:ElShrine.Wpf.ViewModel"
             xmlns:converters="clr-namespace:ElShrine.Wpf.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodel:ColorVM}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ColorToSolidBrushConverter x:Key="ColorToBrush"/>
        <converters:NumToStringConverter x:Key="DoubleToByte"/>
        <converters:NumToStringConverter x:Key="IntToString"/>
        <converters:NumToStringConverter x:Key="DoubleFactor"/>
        <LinearGradientBrush x:Key="ColorGradientBrush" StartPoint="1,0" EndPoint="0,0">
            <GradientStop Color="#ff0000"/>
            <GradientStop Color="#ff00ff" Offset="0.207"/>
            <GradientStop Color="#0000ff" Offset="0.334"/>
            <GradientStop Color="#00ffff" Offset="0.501"/>
            <GradientStop Color="#00ff00" Offset="0.668"/>
            <GradientStop Color="#ffff00" Offset="0.835"/>
            <GradientStop Color="#ff0000" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>
    <Border BorderBrush="{Binding BorderBrush,ElementName=ColorPaletteInstance}" CornerRadius="6" BorderThickness="{Binding BorderThickness,ElementName=ColorPaletteInstance}" Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="FontAttr" Visibility="Collapsed"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="HSVA" Grid.Column="0" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Hue" Grid.Row="0" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="HueSlider" 
                                    HorizontalAlignment="Stretch" Width="auto" Height="20" Grid.Column="0" Maximum="255" Minimum="0" Style="{StaticResource ElShrineSlider_BaseStyle}" Value="{Binding Color.H, ElementName=ColorPaletteInstance}" Background="{StaticResource ColorGradientBrush}"/>
                        <TextBox x:Name="HueTextBox" 
                                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}" Text="{Binding Value,ElementName=HueSlider,Converter={StaticResource IntToString}}" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="Saturation" Grid.Row="1" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SaturationSlider" 
                                    HorizontalAlignment="Stretch" Width="auto" Height="20" Grid.Column="0" Maximum="255" Minimum="0" Style="{StaticResource ElShrineSlider_BaseStyle}" Value="{Binding Color.S,ElementName=ColorPaletteInstance}" Orientation="Horizontal">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,1">
                                    <GradientStop Color="{Binding Color.MinSColor,ElementName=ColorPaletteInstance}"/>
                                    <GradientStop Color="{Binding Color.MaxSColor,ElementName=ColorPaletteInstance}" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="SaturationTextBox" 
                                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}" Text="{Binding Value,ElementName=SaturationSlider,Converter={StaticResource IntToString}}" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="Value" Grid.Row="2" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ValueSlider" 
                                    HorizontalAlignment="Stretch" Width="auto" Height="20" Grid.Column="0" Maximum="255" Minimum="0" Style="{StaticResource ElShrineSlider_BaseStyle}" Value="{Binding Color.V,ElementName=ColorPaletteInstance}" Orientation="Horizontal">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,1">
                                    <GradientStop Color="{Binding Color.MinVColor,ElementName=ColorPaletteInstance}"/>
                                    <GradientStop Color="{Binding Color.MaxVColor,ElementName=ColorPaletteInstance}" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="ValueTextBox" 
                                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}" Text="{Binding Value,ElementName=ValueSlider,Converter={StaticResource IntToString}}" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="Alpha" Grid.Row="3" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="AlphaSlider" 
                                    HorizontalAlignment="Stretch" Width="auto" Height="20" Grid.Column="0" Maximum="255" Minimum="0" Style="{StaticResource ElShrineSlider_BaseStyle}" Value="{Binding Color.A,ElementName=ColorPaletteInstance}" Orientation="Horizontal">
                            <Slider.Background>
                                <DrawingBrush 
                      Viewport="0,0,12,11" ViewportUnits="Absolute" Stretch="None" TileMode="Tile">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#d0cec7">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,6,5" />
                                                        <RectangleGeometry Rect="6,6,6,5" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#e7e7e2">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,5,12,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Slider.Background>
                            <Slider.BorderBrush>
                                <LinearGradientBrush StartPoint="0,1">
                                    <GradientStop Color="Transparent"/>
                                    <GradientStop Color="{Binding Color.NonAlphaColor,ElementName=ColorPaletteInstance,Converter={StaticResource ColorToBrush}}" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.BorderBrush>
                        </Slider>
                        <TextBox x:Name="AlphaTextBox" 
                                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}" Text="{Binding Value,ElementName=AlphaSlider,Converter={StaticResource IntToString}}" HorizontalContentAlignment="Center"/>
                    </Grid>
                </Grid>
                <Grid x:Name="RGB_Code" Grid.Column="1" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Red" Grid.Row="0" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RedSlider" 
                                    HorizontalAlignment="Stretch" Width="auto" Height="20" Grid.Column="0" Maximum="255" Minimum="0" Style="{StaticResource ElShrineSlider_BaseStyle}" Value="{Binding Color.R,ElementName=ColorPaletteInstance}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White"/>
                                    <GradientStop Color="Red" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="RedTextBox" 
                                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}" Text="{Binding Value,ElementName=RedSlider,Converter={StaticResource IntToString}}" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="Green" Grid.Row="1" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="GreenSlider" 
                                    HorizontalAlignment="Stretch" Width="auto" Height="20" Grid.Column="0" Maximum="255" Minimum="0" Style="{StaticResource ElShrineSlider_BaseStyle}" Value="{Binding Color.G,ElementName=ColorPaletteInstance}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White"/>
                                    <GradientStop Color="Green" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="GreenTextBox" 
                                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}" Text="{Binding Value,ElementName=GreenSlider,Converter={StaticResource IntToString}}" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="Blue" Grid.Row="2" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="BlueSlider" 
                                    HorizontalAlignment="Stretch" Width="auto" Height="20" Grid.Column="0" Maximum="255" Minimum="0" Style="{StaticResource ElShrineSlider_BaseStyle}" Value="{Binding Color.B,ElementName=ColorPaletteInstance}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White"/>
                                    <GradientStop Color="Blue" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                        <TextBox x:Name="BlueTextBox" 
                                     Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}" Text="{Binding Value,ElementName=BlueSlider,Converter={StaticResource IntToString}}" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="Code" Grid.Row="3" Height="40">
                        <Label HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                            <Label.Content>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="颜色代码： #" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" VerticalContentAlignment="Center" FontSize="{Binding FontSize, ElementName=FontAttr}" Text="{Binding Color.ARGB_Code,ElementName=ColorPaletteInstance}" Style="{StaticResource ElShrineTextBox_RoundSimpleStyle}"/>
                                </Grid>
                            </Label.Content>
                        </Label>
                    </Grid>
                </Grid>
                <Grid x:Name="PreviewColor" Grid.Column="2" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{Binding Color.ResultColor, ElementName=ColorPaletteInstance,Converter={StaticResource ColorToBrush}}" Height="{Binding ActualHeight, ElementName=HSVA}" MinWidth="{Binding ActualWidth, ElementName=ColorPaletteInstance,Converter={StaticResource DoubleFactor},ConverterParameter=0.12}" RadiusX="5" RadiusY="5"/>
                    <Rectangle Grid.Column="1" Fill="{Binding Color.OppsiteResultColor, ElementName=ColorPaletteInstance,Converter={StaticResource ColorToBrush}}" Height="{Binding ActualHeight, ElementName=HSVA}" MinWidth="{Binding ActualWidth, ElementName=ColorPaletteInstance,Converter={StaticResource DoubleFactor},ConverterParameter=0.04}" RadiusX="5" RadiusY="5"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
