<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ElShrine.Old.Wpf"
                    xmlns:converter="clr-namespace:ElShrine.Old.Wpf.Converters"
                    xmlns:extension="clr-namespace:ElShrine.Old.Wpf.Controls.Extensions">
    <Style x:Key="ElShrineTextBox_BaseStyle" TargetType="{x:Type TextBox}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
            <converter:ToTargetColorBrush x:Key="ToTargetColorBrush"/>
            <converter:ToOppsiteColorBrush x:Key="ToOppsiteColorBrush"/>
        </Style.Resources>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{Binding Option_FontColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="BorderBrush" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="SelectionBrush" Value="{Binding BorderBrush,Converter={StaticResource ToOppsiteColorBrush},ConverterParameter=Brush_-0.4,RelativeSource={RelativeSource Self}}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ControlTemplate.Resources>
                        <converter:ThicknessToDouble x:Key="ThicknessToDouble"/>
                        <converter:ThicknessFactor x:Key="ThicknessFactor"/>
                        <converter:ToOppsiteColorBrush x:Key="ToOppsiteColorBrush"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="rootBorder" 
                                Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessToDouble},ConverterParameter=Max}" Padding="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessFactor},ConverterParameter=0.6}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        <Border.BorderBrush>
                            <MultiBinding Converter="{StaticResource ToOppsiteColorBrush}" ConverterParameter="Brush_-0.4">
                                <Binding Path="BorderBrush" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                <Binding Path="(extension:RateExtension.BackColorRate)" ElementName="rootBorder"/>
                            </MultiBinding>
                        </Border.BorderBrush>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"  
                                                Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" 
                                                To="0"  
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="0" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
                    <Condition Property="IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="SelectionBrush" Value="{Binding BorderBrush,RelativeSource={RelativeSource Self}}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ElShrineTextBox_RoundSimpleStyle" TargetType="{x:Type TextBox}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
            <converter:ToTargetColorBrush x:Key="ToTargetColorBrush"/>
            <converter:ToOppsiteColorBrush x:Key="ToOppsiteColorBrush"/>
        </Style.Resources>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{Binding Option_FontColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="BorderBrush" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="SelectionBrush" Value="{Binding BorderBrush,Converter={StaticResource ToOppsiteColorBrush},ConverterParameter=Brush_-0.4,RelativeSource={RelativeSource Self}}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Width" Value="auto"/>
        <Setter Property="MinWidth" Value="{Binding ActualHeight,RelativeSource={RelativeSource Self}}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="AcceptsReturn" Value="False"/>
        <Setter Property="IsInactiveSelectionHighlightEnabled" Value="False"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ControlTemplate.Resources>
                        <converter:ThicknessToDouble x:Key="ThicknessToDouble"/>
                        <converter:ThicknessFactor x:Key="ThicknessFactor"/>
                        <converter:DoubleFactor x:Key="DoubleFactor"/>
                        <converter:ToOppsiteColorBrush x:Key="ToOppsiteColorBrush"/>
                        <converter:ToTargetColorBrush x:Key="ToTargetColorBrush"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="rootBorder" extension:RateExtension.BackColorRate="0.7" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding ActualHeight,Converter={StaticResource DoubleFactor},ConverterParameter=0.4}" Padding="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessFactor},ConverterParameter=0.6}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource ToTargetColorBrush}" ConverterParameter="0.8">
                                <Binding Path="Background" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                <Binding Path="BorderBrush" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                <Binding Path="(extension:RateExtension.BackColorRate)" ElementName="rootBorder"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelectionActive" Value="true">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="0.7" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.4" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
                    <Condition Property="IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="SelectionBrush" Value="{Binding BorderBrush,RelativeSource={RelativeSource Self}}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>