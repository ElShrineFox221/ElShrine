<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ElShrine.Old.Wpf"
                    xmlns:converter="clr-namespace:ElShrine.Old.Wpf.Converters"
                    xmlns:extension="clr-namespace:ElShrine.Old.Wpf.Controls.Extensions">
    <ControlTemplate x:Key="ElShrineSlider_ThumbDefaultTemplate" TargetType="{x:Type Thumb}">
        <ControlTemplate.Resources>
            <converter:ToOppsiteColorBrush x:Key="ToOppsiteColorBrush"/>
            <converter:DoubleFactor x:Key="DoubleFactor"/>
        </ControlTemplate.Resources>
        <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
            <Border x:Name="rootBorder" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent" BorderThickness="{TemplateBinding BorderThickness}" UseLayoutRounding="True" SnapsToDevicePixels="True" CornerRadius="{TemplateBinding ActualHeight,Converter={StaticResource DoubleFactor},ConverterParameter=0.45}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                <Border x:Name="backBorder" CornerRadius="{Binding CornerRadius,ElementName=rootBorder}" Background="White" Opacity="0.6"/>
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource ToOppsiteColorBrush}" ConverterParameter="Brush_-0.4">
                        <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                        <Binding Path="(extension:RateExtension.ForeColorRate)" ElementName="rootBorder"/>
                    </MultiBinding>
                </Border.BorderBrush>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="False"/>
                    <Condition Property="IsDragging" Value="False"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="backBorder" Storyboard.TargetProperty="Opacity"
                                                 To="0.6" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)" 
                                                To="0" 
                                                Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="backBorder" Storyboard.TargetProperty="Opacity"
                                                 To="0.1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation 
                                    Storyboard.TargetName="rootBorder" Storyboard.TargetProperty="(extension:RateExtension.ForeColorRate)"
                                                 To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ElShrineSlider_HorizontalTemplate" TargetType="{x:Type Slider}">
        <ControlTemplate.Resources>
            <converter:DoubleAdder x:Key="DoubleAdder"/>
            <converter:DoubleFactor x:Key="DoubleFactor"/>
        </ControlTemplate.Resources>
        <Border x:Name="rootBorder" 
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
            <Grid Height="{TemplateBinding Height}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="TrackBackground" Grid.Row="0"
                            SnapsToDevicePixels="True"
                          Margin="{TemplateBinding Padding}" Padding="0" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" UseLayoutRounding="True" CornerRadius="{Binding ActualHeight,RelativeSource={RelativeSource Self},Converter={StaticResource DoubleFactor},ConverterParameter=0.5}">
                    <Border BorderThickness="0"  Background="{TemplateBinding BorderBrush}" Margin="0" Padding="0" ClipToBounds="True" CornerRadius="{Binding ActualHeight,RelativeSource={RelativeSource Self},Converter={StaticResource DoubleFactor},ConverterParameter=0.5}">
                        <Border x:Name="SelectionRange" 
            HorizontalAlignment="Left" Margin="0"
            Background="White" Height="{Binding ActualHeight,ElementName=TrackBackground}"
         BorderThickness="0" UseLayoutRounding="True" VerticalAlignment="center" CornerRadius="{Binding CornerRadius,ElementName=TrackBackground}" Opacity="0.6">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource DoubleAdder}" ConverterParameter="AAA">
                                    <Binding Path="ActualWidth" ElementName="LeftRB"/>
                                    <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>

                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Border>
                <Track x:Name="PART_Track" VerticalAlignment="Center" Grid.Row="0">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton x:Name="LeftRB" Command="{x:Static Slider.DecreaseLarge}" Style="{DynamicResource ElShrineRepeatButton_TransparentStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{DynamicResource ElShrineRepeatButton_TransparentStyle}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb" Focusable="False" OverridesDefaultStyle="True" UseLayoutRounding="True" Template="{StaticResource ElShrineSlider_ThumbDefaultTemplate}" VerticalAlignment="Center" BorderBrush="{TemplateBinding Foreground}" Height="{TemplateBinding Height}" Width="{TemplateBinding Height}" BorderThickness="{TemplateBinding BorderThickness}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelectionRangeEnabled" Value="true">
                <Setter Property="Visibility" TargetName="SelectionRange" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsSelectionRangeEnabled" Value="false">
                <Setter Property="Visibility" TargetName="SelectionRange" Value="Hidden"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="ElShrineSlider_VerticalTemplate" TargetType="{x:Type Slider}">
        <ControlTemplate.Resources>
            <converter:DoubleAdder x:Key="DoubleAdder"/>
            <converter:DoubleFactor x:Key="DoubleFactor"/>
        </ControlTemplate.Resources>
        <Border x:Name="rootBorder" 
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
            <Grid Width="{TemplateBinding Width}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="TrackBackground" Grid.Column="0"
                            SnapsToDevicePixels="True"
                          Margin="{TemplateBinding Padding}" Padding="0" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" UseLayoutRounding="True" CornerRadius="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource DoubleFactor},ConverterParameter=0.5}">
                    <Border BorderThickness="0" Background="{TemplateBinding BorderBrush}" Margin="0" Padding="0" ClipToBounds="True" CornerRadius="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource DoubleFactor},ConverterParameter=0.5}">
                        <Border x:Name="SelectionRange" 
            VerticalAlignment="Bottom" Margin="0"
            Background="White" Width="{Binding ActualWidth,ElementName=TrackBackground}"
         BorderThickness="0" UseLayoutRounding="True" HorizontalAlignment="center" CornerRadius="{Binding CornerRadius,ElementName=TrackBackground}" Opacity="0.6">
                            <Border.Height>
                                <MultiBinding Converter="{StaticResource DoubleAdder}" ConverterParameter="AAA">
                                    <Binding Path="ActualHeight" ElementName="TopRB"/>
                                    <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>

                                </MultiBinding>
                            </Border.Height>
                        </Border>
                    </Border>
                </Border>
                <Track x:Name="PART_Track" HorizontalAlignment="Stretch" Grid.Column="0">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton x:Name="TopRB" Command="{x:Static Slider.DecreaseLarge}" Style="{DynamicResource ElShrineRepeatButton_TransparentStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{DynamicResource ElShrineRepeatButton_TransparentStyle}"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="Thumb" Focusable="False" OverridesDefaultStyle="True" UseLayoutRounding="True" Template="{StaticResource ElShrineSlider_ThumbDefaultTemplate}" HorizontalAlignment="Center" BorderBrush="{TemplateBinding Foreground}" Width="{TemplateBinding Width}" Height="{TemplateBinding Width}" BorderThickness="{TemplateBinding BorderThickness}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelectionRangeEnabled" Value="true">
                <Setter Property="Visibility" TargetName="SelectionRange" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsSelectionRangeEnabled" Value="false">
                <Setter Property="Visibility" TargetName="SelectionRange" Value="Hidden"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="ElShrineSlider_BaseStyle" TargetType="{x:Type Slider}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Width" Value="auto"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template" Value="{StaticResource ElShrineSlider_HorizontalTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Width" Value="16"/>
                <Setter Property="Height" Value="auto"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Template" Value="{StaticResource ElShrineSlider_VerticalTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>