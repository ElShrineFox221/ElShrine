<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:ElShrine.Old.Wpf"
                    xmlns:converter="clr-namespace:ElShrine.Old.Wpf.Converters"
                    xmlns:control="clr-namespace:ElShrine.Old.Wpf.Controls"
                    xmlns:extension="clr-namespace:ElShrine.Old.Wpf.Controls.Extensions">
    <Style x:Key="ElShrineListViewItem_BaseStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="Background" Value="{Binding Background,RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        <Setter Property="Padding" Value="1,1"/>
        <Setter Property="BorderBrush" Value="{Binding BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ControlTemplate.Resources>
                        <converter:ToTargetColorBrush x:Key="ToTargetColorBrush"/>
                        <converter:ThicknessToDouble x:Key="ThicknessToDouble"/>
                        <converter:ThicknessFactor x:Key="ThicknessFactor"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="templateRoot" 
                                BorderBrush="Transparent" BorderThickness="0" SnapsToDevicePixels="true" Margin="0" CornerRadius="0">
                        <Grid>
                            <Grid.Background>
                                <MultiBinding Converter="{StaticResource ToTargetColorBrush}" ConverterParameter="0.6">
                                    <Binding Path="Background" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                    <Binding Path="BorderBrush" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                    <Binding Path="(extension:RateExtension.BackColorRate)" ElementName="Sign_Bd"/>
                                </MultiBinding>
                            </Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Sign_Bd" Grid.Column="0"
                                        Opacity="0"
                                        CornerRadius="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessToDouble},ConverterParameter=Max_0.25}" BorderBrush="{TemplateBinding BorderBrush}" Width="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessToDouble},ConverterParameter=Max}" BorderThickness="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessFactor},ConverterParameter=0.5}" Margin="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessFactor},ConverterParameter=L0_R0.5_T-0.5_B-0.5}"/>
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Margin="{TemplateBinding Padding}"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="Sign_Bd"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="Sign_Bd"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0" 
                                                BeginTime="0:0:0.2"
                                                Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="templateRoot">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ToTargetColorBrush}" ConverterParameter="0.6">
                                        <Binding Path="Background" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                        <Binding Path="BorderBrush" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                        <Binding Path="(extension:RateExtension.BackColorRate)" ElementName="contentPresenter"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="contentPresenter"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="contentPresenter"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="0" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Background" TargetName="templateRoot">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ToTargetColorBrush}" ConverterParameter="0.6">
                                        <Binding Path="Background" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                        <Binding Path="BorderBrush" RelativeSource="{RelativeSource Mode=TemplatedParent}"/>
                                        <Binding Path="(extension:RateExtension.BackColorRate)" ElementName="templateRoot"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="0" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="templateRoot"                    
                                                Storyboard.TargetProperty="(extension:RateExtension.BackColorRate)" 
                                                To="1" 
                                                Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ElShrineListView_BaseStyle" TargetType="{x:Type ListView}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="Foreground" Value="{Binding Option_FontColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{Binding Option_ForeColor,Source={StaticResource OptionProvider}}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
        <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ElShrineListViewItem_BaseStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListView}">
                    <ControlTemplate.Resources>
                        <converter:DoubleToThickness x:Key="DoubleToThickness"/>
                        <converter:ThicknessToDouble x:Key="ThicknessToDouble"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="rootBorder" 
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="1" SnapsToDevicePixels="true">
                        <Grid Height="auto" Width="auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Side1" Grid.Column="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessToDouble},ConverterParameter=Max_0.5}" Width="{TemplateBinding BorderThickness,Converter={StaticResource ThicknessToDouble},ConverterParameter=Max_2}"/>
                            <ScrollViewer Grid.Column="1" Focusable="false" Padding="{TemplateBinding Padding}" Style="{DynamicResource ElShrineScrollViewer_BaseStyle}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" CanContentScroll="False">
                                <StackPanel IsItemsHost="True"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="1" 
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation 
                                                Storyboard.TargetName="rootBorder"                    
                                                Storyboard.TargetProperty="Opacity" 
                                                To="0.57" 
                                                BeginTime="0:0:0.05"
                                                Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsGrouping" Value="true"/>
                                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
