                            <ScrollViewer Grid.Column="1" Focusable="false" Padding="{TemplateBinding Padding}" Style="{DynamicResource ElShrineScrollViewer_BaseStyle}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" >
