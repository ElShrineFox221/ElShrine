<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:control="clr-namespace:ElShrine.Old.Wpf.Controls"
                    xmlns:wpf="clr-namespace:ElShrine.Old.Wpf">
    <Style x:Key="ElShrineLoadingWindow_BaseStyle" TargetType="{x:Type Window}">
        <Style.Resources>
            <ObjectDataProvider x:Key="OptionProvider" MethodName="GetInstance" ObjectType="{x:Type wpf:Option}"/>
        </Style.Resources>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Background="{Binding Option_BackColor, Source={StaticResource OptionProvider}}" Opacity="0.001"/>
                        <control:ElShrineLogoContent x:Name="teclc" Grid.Column="0" Style="{DynamicResource ElShrineLogoContent_Style}" Width="310" Height="310" BorderThickness="3.2" Foreground="{TemplateBinding Foreground}" Background="Transparent" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{Binding Option_ForeColor, Source={StaticResource OptionProvider}}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Height" Value="310"/>
        <Setter Property="Width" Value="310"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="AllowsTransparency" Value="True"/>
    </Style>
</ResourceDictionary>