<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls"
                    xmlns:extensions="clr-namespace:ElShrine.Wpf.Controls.Extensions"
                    xmlns:converters="clr-namespace:ElShrine.Wpf.Converters"
                    xmlns:theme="clr-namespace:ElShrine.Wpf.UITheme">
    <ObjectDataProvider x:Key="ThemeProvider" MethodName="GetInstance" ObjectType="{x:Type theme:ThemeManager}"/>

    <converters:BoolReverseConverter x:Key="BoolReverseConverter"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:IsNullToVisibilityConverter x:Key="IsNullToVisibilityConverter"/>
    <converters:ColorToSolidBrushConverter x:Key="ColorToSolidBrushConverter"/>
    <converters:ColorLerpToSolidBrushConverter x:Key="ColorLerpToSolidBrushConverter"/>
    <converters:QuadruplesConverter x:Key="QuadruplesConverter"/>
    <converters:NumToStringConverter x:Key="NumToStringConverter"/>
    <converters:EnumTextLocalizeConverter x:Key="EnumTextLocalizeConverter"/>
    <converters:LocalizeConverter x:Key="LocalizeConverter"/>
    <DataTemplate x:Key="EnumComboBoxDataTemplate">
        <TextBlock Text="{Binding Converter={StaticResource EnumTextLocalizeConverter}}"/>
    </DataTemplate>
    <Style TargetType="{x:Type controls:EWindow}">
        
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="EBorderThickness" Value="0"/>
        <Setter Property="EBorderCornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="{Binding CurrentTheme.FontSizeNormal, Source={StaticResource ThemeProvider}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EWindow}">
                    <Grid>
                        <Border x:Name="MainBorder" 
                                Margin="8" Background="{TemplateBinding BackBrush}" BorderBrush="{TemplateBinding PrimaryBrush}" BorderThickness="{TemplateBinding EBorderThickness}" CornerRadius="{TemplateBinding EBorderCornerRadius}" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.8" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid x:Name="MainContainerGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" x:Name="TitleBarGrid" 
                                      Margin="{TemplateBinding EBorderCornerRadius, Converter={StaticResource QuadruplesConverter}, ConverterParameter='L_1L|R_1R'}" Height="{TemplateBinding TitleBarHeight}" Background="{TemplateBinding BackBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" Content="{TemplateBinding HeaderContent}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0"/>
                                    <StackPanel Grid.Column="1" 
                                                Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right">
                                        <controls:EButton x:Name="MinButton"
                                                  EBorderThickness="0" Padding="15,2" Margin="1" EBorderCornerRadius="2" Command="{TemplateBinding MinimizeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:EWindow}}}" ContentTemplate="{TemplateBinding HeaderButtonTemplate}" Visibility="{TemplateBinding IsMinimizeButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xE921;" Foreground="{Binding ElementName=MainBorder, Path=BorderBrush}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </controls:EButton>
                                        <controls:EButton x:Name="MaxOrRestoreButton" 
                                                  EBorderThickness="0" Padding="15,2" Margin="1" EBorderCornerRadius="2" Command="{TemplateBinding MaximizeRestoreCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:EWindow}}}" ContentTemplate="{TemplateBinding HeaderButtonTemplate}" Visibility="{TemplateBinding IsMinimizeButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{TemplateBinding MaxOrRestoreIcon}"  Foreground="{Binding ElementName=MainBorder, Path=BorderBrush}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </controls:EButton>
                                        <controls:EButton x:Name="CloseButton"
                                                  EBorderThickness="0" Padding="15,2" Margin="1" EBorderCornerRadius="2" Command="{TemplateBinding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:EWindow}}}" ContentTemplate="{TemplateBinding HeaderButtonTemplate}" Visibility="{TemplateBinding IsCloseButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" SecondaryBrush="Red">
                                            <TextBlock Text="&#xE8BB;" Foreground="{Binding ElementName=MainBorder, Path=BorderBrush}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </controls:EButton>
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>