<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ElShrineLib.Wpf;component/Wpf/ConverterResources.xaml"/>
        <ResourceDictionary Source="/ElShrineLib.Wpf;component/Wpf/ControlResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type controls:EWindow}">
        <Setter Property="MinWidth" Value="600"/>
        <Setter Property="MinHeight" Value="400"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="EBorderThickness" Value="0"/>
        <Setter Property="EBorderCornerRadius" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EWindow}">
                    <Grid>
                        <Border x:Name="MainBorder" 
                                Margin="8" Background="{TemplateBinding BackBrush}" BorderThickness="{TemplateBinding EBorderThickness}" CornerRadius="{TemplateBinding EBorderCornerRadius}" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.8" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid x:Name="MainContainerGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" x:Name="TitleBarGrid" 
                                      Margin="{TemplateBinding EBorderCornerRadius, Converter={StaticResource CommonModifyConverter}, ConverterParameter='L_1L|R_1R'}" Height="{TemplateBinding TitleBarHeight}" Background="{TemplateBinding BackBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" Content="{TemplateBinding HeaderContent}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0"/>
                                    <StackPanel Grid.Column="1" 
                                                Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right">
                                        <StackPanel.Resources>
                                            <Style TargetType="controls:EButton" BasedOn="{StaticResource {x:Type controls:EButton}}">
                                                <Setter Property="EBorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="15,2"/>
                                                <Setter Property="Margin" Value="1"/>
                                                <Setter Property="EBorderCornerRadius" Value="2"/>
                                                <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:EWindow}}}"/>
                                                <Setter Property="ContentTemplate" Value="{Binding RelativeSource={RelativeSource AncestorType=controls:EWindow}, Path=HeaderButtonTemplate}"/>
                                            </Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock_IconStyle}">
                                                <Setter Property="Foreground" Value="{Binding ElementName=MainBorder, Path=BorderBrush}"/>
                                            </Style>
                                        </StackPanel.Resources>
                                        <controls:EButton x:Name="MinButton"
                                                  Command="{TemplateBinding MinimizeCommand}" Visibility="{TemplateBinding IsMinimizeButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="&#xE921;"/>
                                        </controls:EButton>
                                        <controls:EButton x:Name="MaxOrRestoreButton" 
                                                  Command="{TemplateBinding MaximizeRestoreCommand}" Visibility="{TemplateBinding IsMaximizeRestoreButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{TemplateBinding MaxOrRestoreIcon}" />
                                        </controls:EButton>
                                        <controls:EButton x:Name="CloseButton"
                                                  Command="{TemplateBinding CloseCommand}"  ContentTemplate="{TemplateBinding HeaderButtonTemplate}" Visibility="{TemplateBinding IsCloseButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" SecondaryBrush="Red">
                                            <TextBlock Text="&#xE8BB;"/>
                                        </controls:EButton>
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>