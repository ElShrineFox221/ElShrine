<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ElShrine</RootNamespace>
    <BaseOutputPath></BaseOutputPath>
	<PackageOutputPath>..\bin\Packages</PackageOutputPath>
	  <DebugType>embedded</DebugType>

	  <EmbedAllSources>true</EmbedAllSources>

	  <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.24" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElShrineLib\ElShrineLib.csproj" />
  </ItemGroup>

</Project>
