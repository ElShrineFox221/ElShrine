<controls:EWindow x:Class="ElShrine.VisualTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel ="clr-namespace:ElShrine.VisualTool"
        xmlns:controls="clr-namespace:ElShrine.Wpf.Controls;assembly=ElShrineLib.Wpf"
                  xmlns:state="clr-namespace:ElShrine.Wpf.Controls.State;assembly=ElShrineLib.Wpf"
        d:DataContext="{d:DesignInstance Type=viewmodel:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1100" MinWidth="300" MinHeight="600" FontSize="12" EBorderCornerRadius="5" Padding="0" DragResizeEdgeWidth="8">
    <controls:EWindow.Resources>
        <DataTemplate x:Key="ModuleInfoDataTemplate" DataType="{x:Type viewmodel:WpfPageInfoVM}">
            <Grid>
                <Border x:Name="rootBorder" CornerRadius="10" Padding="9,3" Width="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="{Binding CurrentTheme.FontSizeMedium, Source={StaticResource ThemeProvider}}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Text="{Binding Description}" HorizontalAlignment="Stretch" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Tags}" Grid.Row="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="String">
                                    <Border CornerRadius="4" Background="#88AAAAAA" Margin="2,2" Padding="4,1">
                                        <TextBlock Text="{Binding}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Grid.Row="3" Text="{Binding Version}" HorizontalAlignment="Right" FontSize="{Binding CurrentTheme.FontSizeSmall, Source={StaticResource ThemeProvider}}" TextWrapping="Wrap"/>
                    </Grid>
                    <Border.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Data Template:"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DataTemplateUri}" HorizontalAlignment="Stretch" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="5,0,0,0" Text="{Binding DataTemplateName}" FontWeight="Bold"/>
                        </Grid>
                    </Border.ToolTip>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter TargetName="rootBorder" Property="Background" Value="#CCFFCC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="rootBorder" Property="Background" Value="#FFCCCC"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <LinearGradientBrush x:Key="ColorGradientBrush" StartPoint="1,0" EndPoint="0,0">
            <GradientStop Color="#ff0000"/>
            <GradientStop Color="#ff00ff" Offset="0.207"/>
            <GradientStop Color="#0000ff" Offset="0.334"/>
            <GradientStop Color="#00ffff" Offset="0.501"/>
            <GradientStop Color="#00ff00" Offset="0.668"/>
            <GradientStop Color="#ffff00" Offset="0.835"/>
            <GradientStop Color="#ff0000" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ColorGradientBrushV" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#ff0000"/>
            <GradientStop Color="#ff00ff" Offset="0.207"/>
            <GradientStop Color="#0000ff" Offset="0.334"/>
            <GradientStop Color="#00ffff" Offset="0.501"/>
            <GradientStop Color="#00ff00" Offset="0.668"/>
            <GradientStop Color="#ffff00" Offset="0.835"/>
            <GradientStop Color="#ff0000" Offset="1"/>
        </LinearGradientBrush>
    </controls:EWindow.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <controls:ETabControl Grid.Row="1" x:Name="ModulesTabControl" BorderThickness="1" ClipToBounds="False" HorizontalHeaderAlignment="Left" BorderCornerRadius="4"/>
        <Canvas Grid.Row="0" Height="20">
            <Grid Canvas.Right="20" >
                <controls:EExpander ExpandDirection="Down" SlideDistance="200" BorderCornerRadius="5">
                    <controls:EExpander.Header>
                        <TextBlock Text="Modules Manager" HorizontalAlignment="Right"/>
                    </controls:EExpander.Header>
                    <Border Background="#F0F8FF" BorderBrush="#87CEFA" BorderThickness="2" CornerRadius="5" Padding="5">
                        <Grid Grid.Column="0" Width="360">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Refresh" Command="{Binding Source={x:Static viewmodel:WpfPageManagerVM.Refresh}}"/>
                                <Button Grid.Column="1" Content="Confrim" IsEnabled="{Binding Source={x:Static viewmodel:WpfPageManagerVM.IsDirty}}" Command="{Binding ModuleManager.Confrim}" CommandParameter="{Binding ElementName=ModulesTabControl}"/>
                                <Button Grid.Column="2" Content="Cancel" IsEnabled="{Binding Source={x:Static viewmodel:WpfPageManagerVM.IsDirty}}" Command="{Binding Source={x:Static viewmodel:WpfPageManagerVM.Discard}}"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Disabled Modules" FontSize="{Binding CurrentTheme.FontSizeMedium, Source={StaticResource ThemeProvider}}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Enabled Modules" FontSize="{Binding CurrentTheme.FontSizeMedium, Source={StaticResource ThemeProvider}}" HorizontalAlignment="Center"/>
                            <controls:EListView x:Name="DisabledModulesListView" Grid.Row="2" 
ItemsSource="{Binding ModuleManager.DisabledModules}" ItemTemplate="{StaticResource ModuleInfoDataTemplate}" IsDraggable="True" DragItemDropped="DisabledModulesListView_DragItemDropped"/>
                            <controls:EListView x:Name="EnabledModulesListView" Grid.Row="2" Grid.Column="1" 
ItemsSource="{Binding ModuleManager.EnabledModules}" ItemTemplate="{StaticResource ModuleInfoDataTemplate}" IsDraggable="True" DragItemDropped="EnabledModulesListView_DragItemDropped"/>
                        </Grid>
                    </Border>
                </controls:EExpander>
            </Grid>
        </Canvas>
        <Grid Grid.Column="1" Grid.RowSpan="2">
            <StackPanel Background="#FFFFFF">
                <StackPanel Orientation="Vertical">

                </StackPanel>
                <StackPanel Orientation="Horizontal">

                </StackPanel>
                <controls:EToggleButton Name="testETBtn" Content="TEST"/>
                <controls:ESlider x:Name="testEslider" Orientation="Horizontal">
                    <state:StateListener.Rules>
                        <state:RuleCollection>
                            <state:Rule Context="{Binding RelativeSource={RelativeSource Self}}" StateMap="SelfValue"/>
                            <state:Rule Context="{Binding ElementName=testEslider}" StateMap="SelfValue"/>
                        </state:RuleCollection>
                    </state:StateListener.Rules>
                </controls:ESlider>
                <controls:EListView Height="300" Margin="15" Loaded="EListView_Loaded">
                    <controls:EListView.View>
                        <GridView>
                            <GridView.Columns>
                                <GridViewColumn Header="Name">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="viewmodel:TestData">
                                            <TextBlock Text="{Binding Data}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="viewmodel:TestData">
                                            <TextBlock Text="{Binding V}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView.Columns>
                        </GridView>
                    </controls:EListView.View>
                </controls:EListView>
            </StackPanel>
        </Grid>
    </Grid>
</controls:EWindow>
