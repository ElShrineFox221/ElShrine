<UserControl x:Class="ElShrine.VisualTool.Pages.OptionsHub.PREVIEW"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ElShrine.VisualTool.Pages.OptionsHub"
             xmlns:controls="clr-namespace:ElShrine.Wpf.Controls;assembly=ElShrineLib.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:OptionsHubVM,IsDesignTimeCreatable=True}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <controls:EListBox x:Name="PART_NavigationListBox" 
                   Width="200" ItemsSource="{Binding OptionGroups}" SelectionMode="Single" Margin="5" SelectionChanged="NavigationListBox_SelectionChanged" Loaded="Navigations_ViewLoaded">
            <controls:EListBox.ItemTemplate>
                <DataTemplate DataType="module:OptionHubVM.OptionGroup">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GroupShortName}"/>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="({0} in {1})">
                                    <Binding Path="Items.Count"/>
                                    <Binding Path="ClassesCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </controls:EListBox.ItemTemplate>
        </controls:EListBox>
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.Resources>
                    <Style TargetType="controls:EButton">
                        <Setter Property="Width" Value="80"/>
                        <Setter Property="Margin" Value="5,0,0,0"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <controls:EToggleButton Content="Preview" Margin="-3,0,0,0" HorizontalAlignment="Left" IsChecked="{Binding PreviewEnabled}"/>
                    <controls:EButton Command="{x:Static local:OptionsHubVM.UpdateCommand}" Content="Update"/>
                    <controls:EButton Command="{x:Static local:OptionsHubVM.SaveCommand}" Content="Save" IsEnabled="{Binding IsOptionsChanged}"/>
                    <controls:EButton Command="{x:Static local:OptionsHubVM.CancelCommand}" Content="Cancel" IsEnabled="{Binding IsOptionsChanged}"/>
                </StackPanel>
                <controls:EButton Grid.Column="2" Command="{x:Static local:OptionsHubVM.ResetCommand}" Content="Reset"/>
            </Grid>
            <controls:EScrollViewer x:Name="PART_ContentScrollViewer" Grid.Row="1" Margin="-10,2,-3,0"
                                    VerticalScrollBarMargin="0,3,0,0" Padding="0"
                            ScrollChanged="ContentScrollViewer_ScrollChanged" Loaded="Navigations_ViewLoaded">
                <ItemsControl ItemsSource="{Binding OptionGroups}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:OptionGroupVM">
                            <StackPanel>
                                <controls:EExpander Margin="7,5,5,5" Loaded="Navigations_ViewLoaded" Expanded="EExpander_Expanded" DataContext="{Binding}">
                                    <controls:EExpander.Header>
                                        <TextBlock Text="{Binding GroupShortName}" FontWeight="Bold"/>
                                    </controls:EExpander.Header>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Line X1="0" X2="1" Stretch="Fill" Margin="5,2,10,2" Opacity="0.7" 
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                              StrokeThickness="1.7" Stroke="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                        <ItemsControl Grid.Row="1" Margin="4,0" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="local:OptionItemVM">
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderGroup"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"  Text="{Binding ItemName}" ToolTip="{Binding Description}" VerticalAlignment="Center"/>
                                                        <ContentControl Grid.Column="1" Content="{Binding Control}" Loaded="ContentControl_Loaded" 
                                HorizontalAlignment="Stretch">

                                                        </ContentControl>
                                                    </Grid>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    
                                </controls:EExpander>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </controls:EScrollViewer>
        </Grid>
    </Grid>
</UserControl>
