             xmlns:local="clr-namespace:ElShrine"
             StartupUri="Modules\MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ElShrineWpfLib;component/Wpf/ConverterResources.xaml"/>
