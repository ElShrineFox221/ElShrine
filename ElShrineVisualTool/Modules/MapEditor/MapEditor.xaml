<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewmodel="clr-namespace:ElShrine.Modules.MapEditor.ViewModel"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:ElShrine.Wpf.Controls;assembly=ElShrineLib.Wpf"
                    x:Class="ElShrine.Modules.MapEditor.MapEditor">
    <system:Double x:Key="upDouble">0.1</system:Double>
    <system:Int32 x:Key="upInt">1</system:Int32>
    <system:Double x:Key="downDouble">-0.1</system:Double>
    <system:Int32 x:Key="downInt">-1</system:Int32>
    <DataTemplate x:Key="MapEditorTemplate" DataType="{x:Type viewmodel:MapEditorVM}">
        <TabControl x:Name="MapEditorRoot" SelectionChanged="MapEditorRoot_SelectionChanged">
            <TabItem Header="Global">
                <ContentControl Grid.Row="1" x:Name="GlobalPanel" ContentTemplate="{DynamicResource GlobalPanelTemplate}" Content="{Binding ElementName=MapEditorRoot,Path=DataContext}"/>
            </TabItem>
            <TabItem Header="Map" IsEnabled="{Binding MapEnable}">
                <ContentControl x:Name="MapPanel" ContentTemplate="{DynamicResource MapTemplate}" Content="{Binding SelectedMap}"/>
            </TabItem>
            <TabItem Header="Drawing" IsEnabled="{Binding MapEnable}">
                <ContentControl x:Name="DrawingPanel" ContentTemplate="{DynamicResource DrawingPanelTemplate}" Content="{Binding SelectedMap}"/>
            </TabItem>
        </TabControl>
    </DataTemplate>

    <DataTemplate x:Key="GlobalPanelTemplate" DataType="{x:Type viewmodel:MapEditorVM}">
        <Grid x:Name="GlobalPanelRoot" MinWidth="300">
            <Grid x:Name="LoadedMapsPanel" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2">
                    <Run Text="Loaded Maps Panel" FontSize="20"/>
                    <Run Text="  [NOTE]" Foreground="RoyalBlue"/>
                    <Run Text="Double click with a item the loaded map list listed to selecte a map." Foreground="Gray"/>
                </TextBlock>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Save all" Command="{Binding SaveLoadedMaps}"/>
                </Grid>
                <ListBox x:Name="LoadedMapsContainer" Grid.Row="2" ItemsSource="{Binding LoadedMaps}" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewmodel:MapVM}">
                            <Grid x:Name="MapVMItem">
                                <Grid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.SelectedMapChange,ElementName=GlobalPanelRoot}" CommandParameter="{Binding ElementName=MapVMItem, Path=DataContext}"/>
                                </Grid.InputBindings>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" Margin="0,0,20,0">
                                        <Run Text="{Binding PublicName, Mode=OneWay}"/>
                                        <Run Text="{Binding FileName, Mode=OneWay}" Foreground="Gray"/>
                                    </TextBlock>
                                    <TextBlock FontSize="14" Text="Saved" Foreground="Green" Visibility="{Binding Dirtied, Converter={StaticResource BoolToVisibilityConverter},ConverterParameter=Reverse}"/>
                                    <TextBlock FontSize="14" Text="Changed" Foreground="Red" Visibility="{Binding Dirtied, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding IdenticalName, Mode=OneWay}" Margin="10,0,0,0" Foreground="Gray" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button MinWidth="10" Command="{Binding OpenMapImportDialog}" Content="Select" FontSize="13" Padding="6,0,5,0"/>
                    <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="{Binding MapImportPath}" VerticalContentAlignment="Center" Padding="3,0,5,0" FontSize="13"/>
                    <TextBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" HorizontalAlignment="Stretch" Text="{Binding MapNameInputBar}" VerticalContentAlignment="Center" Padding="3,0,5,0" FontSize="13"/>
                    <Button Grid.Column="2" Content="Import" HorizontalAlignment="Stretch" Command="{Binding MapImportConfrim}" FontSize="13" Padding="5,0"/>
                    <Button Grid.Column="2" Grid.Row="1" Content="New" HorizontalAlignment="Stretch" Command="{Binding CreateNewMap}" FontSize="13" Padding="5,0"/>
                </Grid>
                <Border x:Name="SelectedMapPanel" 
                        Grid.Row="1" Grid.RowSpan="4" Grid.Column="1" BorderThickness="1" BorderBrush="Gray" IsEnabled="{Binding MapEnable}">
                    <Grid Margin="5" Width="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Selected Map" Grid.ColumnSpan="2" FontSize="15" Margin="0,0,0,5"/>
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="Gray">
                            <TextBlock Text="{Binding SelectedMap.PublicName}" VerticalAlignment="Center" Margin="5,0"/>
                        </Border>
                        <TextBox x:Name="RenameTextBox" 
                                 Grid.Row="1" Grid.Column="0" Visibility="{Binding RenameEnabled,Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding SelectedMap.PublicName}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding RenameMap}" CommandParameter="{Binding ElementName=RenameTextBox, Path=Text}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button x:Name="RenameButton" Grid.Row="1" Grid.Column="1" Content="Rename" Command="{Binding RenameMap}" CommandParameter="{Binding ElementName=RenameTextBox, Path=Text}"/>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="5,10" Visibility="{Binding MapEnable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition x:Name="space" Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Margin="2" Grid.Row="0" Text="Seed:"/>
                            <TextBlock Margin="2" Grid.Row="0" Grid.Column="2" Text="{Binding SelectedMap.Seed, Mode=OneWay}"/>
                            <TextBlock Margin="2" Grid.Row="1" Text="Ranks:"/>
                            <TextBlock Margin="2" Grid.Row="1" Grid.Column="2" Text="{Binding SelectedMap.PerlinNoisePanel.RankCount}"/>
                            <TextBlock Margin="2" Grid.Row="2" Text="Size:"/>
                            <TextBlock Margin="2" Grid.Row="2" Grid.Column="2">
                                <Run Text="{Binding SelectedMap.Width, Mode=OneWay}"/>
                                <Run Text=","/>
                                <Run Text="{Binding SelectedMap.Height, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="2" Grid.Row="3" Text="ID name:"/>
                            <TextBlock Margin="2" Grid.Row="3" Grid.Column="2" TextWrapping="Wrap">
                                <Run Text="[Directory]" Foreground="RoyalBlue">
                                    <Run.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenDirectory}" CommandParameter="{Binding SelectedMap.Directory}"/>
                                    </Run.InputBindings>
                                </Run>
                                <Run Text="\"/>
                                <Run Text="{Binding SelectedMap.PublicName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="2" Grid.Row="4" Text="File name:"/>
                            <TextBlock Margin="2" Grid.Row="4" Grid.Column="2" Text="{Binding SelectedMap.FileName, Mode=OneWay}"/>

                            <Button Margin="2" Grid.Row="5" Grid.ColumnSpan="3" Content="Delete" Command="{Binding DeleteMap}"/>
                            <Button Margin="2" Grid.Row="6" Grid.ColumnSpan="3" Content="Save as png" Command="{Binding SaveImageFile}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>


    <DataTemplate x:Key="MapViewerTemplate" DataType="{x:Type viewmodel:MapVM}">
        <Grid x:Name="MapViewer" Grid.Row="2">
            <Border BorderBrush="Gray" BorderThickness="2" Margin="0,0,3,0" Padding="0,0,0,0" CornerRadius="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="MapImage" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="MapImageGrid" Background="#FFBBBBBB">
                            <Border 
                    Width="auto" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Margin="40,10,40,30">
                                <Border.Effect>
                                    <DropShadowEffect Direction="315" BlurRadius="4" ShadowDepth="10" Color="Black" Opacity="0.7" />
                                </Border.Effect>
                                <Border BorderThickness="1.5" BorderBrush="OrangeRed">
                                    <Border.Background>
                                        <DrawingBrush TileMode="Tile" Stretch="Fill" ViewportUnits="Absolute" Viewport="0,0,24,24">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <DrawingGroup.Children>
                                                        <GeometryDrawing Brush="White">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="0,0,24,24"/>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                        <GeometryDrawing Brush="#FF888888">
                                                            <GeometryDrawing.Geometry>
                                                                <GeometryGroup>
                                                                    <RectangleGeometry Rect="0,0,12,12"/>
                                                                    <RectangleGeometry Rect="12,12,12,12"/>
                                                                </GeometryGroup>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingGroup.Children>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>
                                    <Grid Width="{Binding Width, Mode=OneWay}" Height="{Binding Height}" x:Name="ImageDirectContainer" MouseMove="ImageDirectContainer_MouseMove" 
            MouseEnter="ImageDirectContainer_MouseEnter" MouseLeave="ImageDirectContainer_MouseLeave" MouseLeftButtonDown="ImageDirectContainer_MouseLeftButtonDown" MouseLeftButtonUp="ImageDirectContainer_MouseLeftButtonUp" Background="Transparent">
                                        <ContentControl x:Name="ResenderingPanelImage" Content="{Binding ResenderingPanel}" ContentTemplate="{DynamicResource ResenderingPanelImageTemplate}" Visibility="{Binding ResenderingPanel.MapIsVisible,Converter={StaticResource BoolToVisibilityConverter}}" IsHitTestVisible="False"/>
                                        <ContentControl x:Name="DrawingPanelImage" Content="{Binding DrawingPanel}" ContentTemplate="{DynamicResource DrawingPanelImageTemplate}" IsHitTestVisible="False" Visibility="{Binding DrawingPanel.MapIsVisible,Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Grid.LayoutTransform>
                                            <TransformGroup x:Name="ScaleMapTransfer">
                                                <ScaleTransform ScaleX="{Binding MapScale}" ScaleY="{Binding MapScale}"/>
                                            </TransformGroup>
                                        </Grid.LayoutTransform>
                                    </Grid>

                                </Border>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <ContentControl x:Name="StatusBar" 
                            Grid.Row="1" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="DrawingPanelStatusBar"
                                                Grid.Column="0" Content="{Binding DrawingPanel}" ContentTemplate="{DynamicResource DrawingPanelStatusBarTemplate}"/>
                            <Grid Grid.Column="1" HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Scale:" VerticalAlignment="Center"/>
                                <TextBox x:Name="ScaleTextBox" 
Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="5,0,0,0" MinWidth="20" Text="{Binding MapPercentScale, Converter={StaticResource NumToStringConverter}}" Background="Transparent">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ChangeMapScale}" CommandParameter="{Binding ElementName=ScaleTextBox, Path=Text}"/>
                                        <KeyBinding Key="Up" Command="{Binding ChangeMapScale}" CommandParameter="{StaticResource upInt}"/>
                                        <KeyBinding Key="Down" Command="{Binding ChangeMapScale}" CommandParameter="{StaticResource downInt}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </ContentControl>
                </Grid>
                <Border.InputBindings>
                    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ChangeMapScale}" CommandParameter="{StaticResource upDouble}"/>
                    <KeyBinding Gesture="Ctrl+Subtract" Key="Subtract" Command="{Binding ChangeMapScale}" CommandParameter="{StaticResource downDouble}"/>
                </Border.InputBindings>
            </Border>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PerlinNoisePanelTemplate" DataType="{x:Type viewmodel:PerlinNoisePanelVM}">
        <GroupBox x:Name="PerlinNoisePanelRoot" VerticalAlignment="Stretch" BorderThickness="2" BorderBrush="Gray">
            <GroupBox.Header>
                <TextBlock Text="Perlin Noise Panel"/>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="SeedField" Margin="10,5,15,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Seed:"/>
                    <TextBox x:Name="SeedTextBox" 
                             Grid.Row="0" Grid.Column="1" Text="{Binding Seed, Converter={StaticResource NumToStringConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="4,0,0,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ChangeSeed}" CommandParameter="{Binding ElementName=SeedTextBox, Path=Text}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Content="Random" Margin="0,0,0,0" Command="{Binding RandomSeed}"/>
                </Grid>
                <GroupBox Header="Ranks" Grid.Row="1" BorderBrush="Gray" BorderThickness="1.5">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="5,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,10,0" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Ranks:"/>
                                <TextBox Grid.Column="1" 
               Text="{Binding RankCount, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Margin="4,0,0,0">
                                    <TextBox.InputBindings>
                                        <KeyBinding Command="{Binding GenerateRanks}" Key="Enter"/>
                                        <KeyBinding Command="{Binding RankCountChange}" CommandParameter="-1" Key="Down"/>
                                        <KeyBinding Command="{Binding RankCountChange}" CommandParameter="1" Key="Up"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Row="1" Grid.Column="2" Content="Regen" Padding="5,0" Command="{Binding GenerateRanks}"/>
                            </Grid>
                            <Button Grid.Row="1" Content="Regenerate NoiseMap" Margin="0,5,10,0" Command="{Binding RegenerateNoise}" IsEnabled="{Binding Regeneratable}"/>
                        </Grid>
                        <Border Grid.Row="1" BorderThickness="2,0,0,0" BorderBrush="Black" Padding="5,0" Margin="5">
                            <ItemsControl x:Name="RanksContainer" BorderThickness="0" ItemsSource="{Binding ViewModels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewmodel:RankVM}">
                                        <StackPanel>
                                            <ContentControl x:Name="RankElementContainer" Width="150" Margin="-5,-1">
                                                <Border BorderThickness="0,0,2,2" BorderBrush="Gray" CornerRadius="5,0,0,5" Margin="0,-2,-3,0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Frequency" VerticalAlignment="Center" Margin="5,3"/>
                                                        <TextBox x:Name="FrequencyTextBox" 
                                                                 Grid.Column="1" Text="{Binding Frequency, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Center" Margin="0,3,3,3">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Command="{Binding ChangeFrequency}" CommandParameter="{Binding ElementName=FrequencyTextBox, Path=Text}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <TextBlock Grid.Row="1" Text="Amplitude" VerticalAlignment="Center" Margin="5,3"/>
                                                        <TextBox x:Name="AmplitudeTextBox" 
                                                                 Grid.Row="1" Grid.Column="1"  Margin="0,3,3,3" Text="{Binding Amplitude, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Center">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Command="{Binding ChangeAmplitude}" CommandParameter="{Binding ElementName=AmplitudeTextBox, Path=Text}"/>
                                                            </TextBox.InputBindings>
                                                        </TextBox>

                                                        <Canvas Grid.Column="2" Width="10">
                                                            <Button x:Name="DeleteButton" Canvas.Right="0" Canvas.Top="0" VerticalAlignment="Center" Margin="-5,3,-3,0" Width="15" Height="15" Background="Transparent" BorderThickness="0" Command="{Binding ElementName=PerlinNoisePanelRoot, Path=DataContext.Remove}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self},Path=DataContext}">
                                                                <Path  Margin="0" Data="M50,25 L25,50 M25,25 50,50" Fill="#FFF4F4F5" Stretch="Fill" Stroke="DarkRed" StrokeThickness="2" HorizontalAlignment="Right"/>
                                                                <Button.RenderTransform>
                                                                    <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                                </Button.RenderTransform>
                                                            </Button>
                                                        </Canvas>
                                                    </Grid>
                                                </Border>
                                            </ContentControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ItemsControl Grid.Row="2" Padding="4,0,9,0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Button Content="Add" Command="{Binding Add}" Margin="1"/>
                            <Button Content="Clear" Margin="1" Command="{Binding Clear}"/>
                        </ItemsControl>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate x:Key="ResenderingPanelToolBarTemplate" DataType="{x:Type viewmodel:ResenderingPanelVM}">
        <GroupBox BorderThickness="2" BorderBrush="Gray">
            <GroupBox.Header>
                <TextBlock Text="Resendering"/>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Regen Noised Map" Command="{Binding RegenerateNoiseImage}" IsEnabled="{Binding Regeneratable}" FontSize="13" Padding="10,2"/>
                <ComboBox x:Name="MapStyleComboBox"
Grid.Column="1" SelectedIndex="0" FontSize="13" Width="80" VerticalContentAlignment="Center" SelectedItem="{Binding SelectedMapViewType}">
                    <ComboBoxItem Content="Gray"/>
                    <ComboBoxItem Content="Colored"/>
                </ComboBox>
                <Border x:Name="MapResenderInfo" 
Grid.Column="2" BorderBrush="#444444" BorderThickness="1" Padding="0" Margin="0">
                    <Grid VerticalAlignment="Stretch" Margin="0,-1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="MapResizeableSign" Visibility="Collapsed" IsEnabled="{Binding ElementName=MapSizeLockCheckBox, Converter={StaticResource BoolReverseConverter}, Path=IsChecked}"/>
                        <CheckBox Grid.Column="0" x:Name="MapSizeLockCheckBox" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5,2,5,0">
                            Fixed
                        </CheckBox>
                        <Border Grid.Column="1" BorderThickness="1" BorderBrush="Gray">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" IsEnabled="{Binding ElementName=MapResizeableSign, Path=IsEnabled}">
                                <Label FontSize="13" Content="width" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5,0" Padding="0"/>
                                <TextBox x:Name="RewidenTextBox" Text="{Binding Width, Mode=TwoWay, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="35" HorizontalContentAlignment="Right" Margin="0,0,0,-1" BorderBrush="Transparent">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding Rewiden}" CommandParameter="{Binding ElementName=RewidenTextBox, Path=Text}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderThickness="1" BorderBrush="Gray" Margin="-1,0">
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding ElementName=MapResizeableSign, Path=IsEnabled}">
                                <Label FontSize="13" Content="height" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5,0" Padding="0"/>
                                <TextBox x:Name="ReheightenTextBox" IsEnabled="{Binding ElementName=MapResizeableSign, Path=IsEnabled}" Text="{Binding Height, Mode=TwoWay, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="35" HorizontalContentAlignment="Right" Margin="0,0,0,-1" BorderBrush="Transparent">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding Reheighten}" CommandParameter="{Binding ElementName=ReheightenTextBox, Path=Text}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border x:Name="MapContourInfo" 
Grid.Column="4" BorderThickness="1" BorderBrush="#444444" Padding="0" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="MapContourEnableSign" Visibility="Collapsed" IsEnabled="{Binding ElementName=MapContourLockCheckBox, Path=IsChecked}"/>
                        <CheckBox Grid.Column="0" x:Name="MapContourLockCheckBox" 
          VerticalAlignment="Stretch" IsChecked="{Binding ContourMapVisible}" VerticalContentAlignment="Center" Margin="5,2,5,0">
                            Contour
                        </CheckBox>
                        <Border Grid.Column="1" BorderThickness="1" BorderBrush="Gray" Margin="0,-1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" IsEnabled="{Binding ElementName=MapContourEnableSign, Path=IsEnabled}">
                                <Label FontSize="13" Content="mount" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5,0" Padding="0"/>
                                <TextBox x:Name="ContoursTextBox" Text="{Binding Contours, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="20" HorizontalContentAlignment="Right" Margin="0,0,0,-1" BorderBrush="Transparent">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ContoursChange}" CommandParameter="{Binding ElementName=ContoursTextBox, Path=Text}"/>
                                        <KeyBinding Key="Up" Command="{Binding ContoursChange}" CommandParameter="{StaticResource upInt}"/>
                                        <KeyBinding Key="Down" Command="{Binding ContoursChange}" CommandParameter="{StaticResource downInt}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderThickness="1" BorderBrush="Gray" Margin="-1,-1">
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding ElementName=MapContourEnableSign, Path=IsEnabled}">
                                <Label FontSize="13" Content="pen width" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="5,0" Padding="0"/>
                                <TextBox x:Name="ContourLineWidthChangeTextBox" Text="{Binding ContourLineWidth, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="24" HorizontalContentAlignment="Right" Margin="0,0,0,-1" BorderBrush="Transparent">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ContourLineWidthChange}" CommandParameter="{Binding ElementName=ContourLineWidthChangeTextBox, Path=Text}"/>
                                        <KeyBinding Key="Up" Command="{Binding ContourLineWidthChange}" CommandParameter="{StaticResource upDouble}"/>
                                        <KeyBinding Key="Down" Command="{Binding ContourLineWidthChange}" CommandParameter="{StaticResource downDouble}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>
    </DataTemplate>
    <DataTemplate x:Key="ResenderingPanelImageTemplate" DataType="{x:Type viewmodel:ResenderingPanelVM}">
        <Grid>
            <Image Source="{Binding GrayMapImage}" Visibility="{Binding GrayMapVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=collapsed}"/>
            <Image Source="{Binding ColoredMapImage}" Visibility="{Binding ColoredMapVisible, Converter={StaticResource BoolToVisibilityConverter},ConverterParameter=collapsed}"/>
            <Image Source="{Binding ContourMapImage}" Visibility="{Binding ContourMapVisible, Converter={StaticResource BoolToVisibilityConverter},ConverterParameter=collapsed}"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DrawingPanelToolBarTemplate" DataType="{x:Type viewmodel:DrawingPanelVM}">
        <Grid>
            <ToolBarTray>
                <ToolBar FontSize="13">
                    <ToolBar.Header>
                        <TextBlock Text="DrawMode"/>
                    </ToolBar.Header>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="Select" TextDecorations="Underline"/>
                    </RadioButton>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="Point" TextDecorations="Underline"/>
                    </RadioButton>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="Line" TextDecorations="Underline"/>
                    </RadioButton>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="Curve" TextDecorations="Underline"/>
                    </RadioButton>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="Rectangle" TextDecorations="Underline"/>
                    </RadioButton>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="Circle" TextDecorations="Underline"/>
                    </RadioButton>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="Poly" TextDecorations="Underline"/>
                    </RadioButton>
                    <RadioButton GroupName="DrawingActionType" Command="{Binding ChangeAction}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Content.Text}">
                        <TextBlock Text="PolyCurve" TextDecorations="Underline"/>
                    </RadioButton>
                </ToolBar>
            </ToolBarTray>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DrawingPanelImageTemplate" DataType="{x:Type viewmodel:DrawingPanelVM}">
        <Grid Background="White">
            <Image Source="{Binding DrawingEleImage}"/>
            <Image Source="{Binding CurrentEleImage}"/>
            <Image Source="{Binding PreviewEleImage}"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DrawingPanelStatusBarTemplate" DataType="{x:Type viewmodel:DrawingPanelVM}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding CusorMapPositionInfo}" VerticalAlignment="Center" Margin="5,2"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                <Run Text="Action:"/>
                <Run Text="{Binding CurrentActionInfo,Mode=OneWay}"/>
            </TextBlock>
        </Grid>
    </DataTemplate> 
    <DataTemplate x:Key="MapPanelMainTemplate" DataType="{x:Type viewmodel:MapVM}">
        <Grid x:Name="MapPanelMainRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl x:Name="ResenderingToolBar" Grid.Row="0" Content="{Binding ResenderingPanel}" ContentTemplate="{DynamicResource ResenderingPanelToolBarTemplate}"/>
            <ContentControl x:Name="MapResenderingViewer" Grid.Row="1" Content="{Binding ElementName=MapPanelMainRoot,Path=DataContext}" ContentTemplate="{DynamicResource MapViewerTemplate}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ColorPaintPanelTemplate" DataType="{x:Type viewmodel:ColorPaintPanelVM}">
        <Grid x:Name="ColorPaintPanelRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToggleButton x:Name="FoldedToggleButton" IsChecked="{Binding PanelFolded}">
                <TextBlock Text="Paint">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </ToggleButton>
            <GroupBox x:Name="ColorPaintPanel" 
                      VerticalAlignment="Stretch" Grid.Column="1" Grid.RowSpan="2" Margin="4,0,0,0" Visibility="{Binding PanelFolded,Converter={StaticResource BoolToVisibilityConverter},ConverterParameter=collapsed}" BorderThickness="2" BorderBrush="Gray">
                <GroupBox.Header>
                    <TextBlock Text="Color Paint Panel"/>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderThickness="2,0,0,0" BorderBrush="Black" Padding="5,0,0,0" Margin="5">
                        <ItemsControl x:Name="FillColorsContainer" 
                                  HorizontalContentAlignment="Stretch" BorderThickness="0" ItemsSource="{Binding ViewModels}" Margin="0,0,-3,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodel:FillColorVM}">
                                    <Border x:Name="FillColorElementContainer" BorderThickness="0,0,2,2" BorderBrush="Gray" CornerRadius="5,0,0,5">
                                        <Grid VerticalAlignment="Stretch" Width="150">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="0"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Margin="4,2" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
Command="{Binding ElementName=ColorPaintPanel, Path=DataContext.OpenPalette}" CommandParameter="{Binding ElementName=FillColorElementContainer}" BorderBrush="Transparent" BorderThickness="0" Height="32" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent">
                                                <Border CornerRadius="7">
                                                    <Border.Background>
                                                        <DrawingBrush TileMode="Tile" Stretch="UniformToFill" ViewportUnits="Absolute" Viewport="0,0,12,12">
                                                            <DrawingBrush.Drawing>
                                                                <DrawingGroup>
                                                                    <DrawingGroup.Children>
                                                                        <GeometryDrawing Brush="White">
                                                                            <GeometryDrawing.Geometry>
                                                                                <RectangleGeometry Rect="0,0,24,24"/>
                                                                            </GeometryDrawing.Geometry>
                                                                        </GeometryDrawing>
                                                                        <GeometryDrawing Brush="#FF888888">
                                                                            <GeometryDrawing.Geometry>
                                                                                <GeometryGroup>
                                                                                    <RectangleGeometry Rect="0,0,12,12"/>
                                                                                    <RectangleGeometry Rect="12,12,12,12"/>
                                                                                </GeometryGroup>
                                                                            </GeometryDrawing.Geometry>
                                                                        </GeometryDrawing>
                                                                    </DrawingGroup.Children>
                                                                </DrawingGroup>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" CornerRadius="7" BorderBrush="Transparent" Background="{Binding Color, Converter={StaticResource ColorToSolidBrushConverter}}"/>
                                                </Border>
                                            </Button>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="5,-2,20,-2" Text="{Binding ColorCode, Mode=OneWay}"/>
                                            <Canvas Width="0" Grid.Column="2" HorizontalAlignment="Right">
                                                <Button x:Name="DeleteButton" Canvas.Right="0" Canvas.Top="0" VerticalAlignment="Center" Margin="0,2,-3,0" Width="15" Height="15" Background="Transparent" BorderThickness="0" Command="{Binding ElementName=ColorPaintPanel,Path=DataContext.Remove}" CommandParameter="{Binding ElementName=FillColorElementContainer, Path=DataContext}">
                                                    <Path  Margin="0" Data="M50,25 L25,50 M25,25 50,50" Fill="#FFF4F4F5" Stretch="Fill" Stroke="DarkRed" StrokeThickness="2" HorizontalAlignment="Right"/>
                                                    <Button.RenderTransform>
                                                        <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                                    </Button.RenderTransform>
                                                </Button>
                                            </Canvas>
                                            <TextBox x:Name="FillColorValueTextBox" FontSize="12"
             Grid.Row="1" Grid.Column="1" Text="{Binding Value, Converter={StaticResource NumToStringConverter}}" VerticalAlignment="Center" Margin="5,0,5,1">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Up" Command="{Binding ChangeValue}" CommandParameter="{StaticResource upDouble}"/>
                                                    <KeyBinding Key="Down" Command="{Binding ChangeValue}" CommandParameter="{StaticResource upDouble}"/>
                                                    <KeyBinding Key="Enter" Command="{Binding ChangeValue}" CommandParameter="{Binding ElementName=FillColorValueTextBox, Path=Text}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ItemsControl Grid.Row="1" Padding="4,0,9,0">
                        <Button Content="Add" Command="{Binding Add}" Margin="1"/>
                        <Button Content="Clear" Margin="1" Command="{Binding Clear}"/>
                    </ItemsControl>
                    <Popup IsOpen="{Binding PaletteOpened}" 
StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding SelectedItem}">
                        <Grid Background="Transparent">
                            <Border CornerRadius="15" Background="White" Margin="0,0,8,8" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Color Pelatte" FontSize="15"/>
                                    <controls:EColorPalette Width="500" ResultColor="{Binding PaletteColor}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="1" Margin="5,5,1,-3" Content="Cancel" Command="{Binding ClosePalette}" Style="{DynamicResource ElShrineButton_BaseStyle}" BorderThickness="12"/>
                                        <Button Grid.Column="2" Margin="5,5,1,-3" Content="Confrim" Command="{Binding ConfrimPalette}" Style="{DynamicResource ElShrineButton_BaseStyle}" BorderThickness="12"/>
                                    </Grid>
                                </StackPanel>
                                <Border.Effect>
                                    <DropShadowEffect Direction="320" BlurRadius="6" ShadowDepth="8" Color="Black" Opacity="0.3" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>
            </GroupBox>
            <Border x:Name="FillColorPreviewer" 
                    Grid.Row="1" Grid.RowSpan="3" BorderBrush="Gray" BorderThickness="1" CornerRadius="0,0,8,8">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Stretch="UniformToFill" ViewportUnits="Absolute" Viewport="0,0,12,12">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <DrawingGroup.Children>
                                    <GeometryDrawing Brush="White">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,24,24"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#FF888888">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,12,12"/>
                                                <RectangleGeometry Rect="12,12,12,12"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup.Children>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Border CornerRadius="0,0,7,7" Background="{Binding VerticalGradientFillColorBrush}"/>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MapTemplate" DataType="{x:Type viewmodel:MapVM}">
        <Grid x:Name="MapPanelRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="PerlinNoisePanel" Grid.Column="0" Content="{Binding PerlinNoisePanel}" ContentTemplate="{DynamicResource PerlinNoisePanelTemplate}"/>
            <ContentControl x:Name="MapPanelMain" Grid.Column="1" Content="{Binding ElementName=MapPanelRoot,Path=DataContext}" ContentTemplate="{DynamicResource MapPanelMainTemplate}"/>
            <ContentControl x:Name="ColorPaintPanel" Grid.Column="2" Content="{Binding ColorPaintPanel}" ContentTemplate="{DynamicResource ColorPaintPanelTemplate}"/>
        </Grid>
    </DataTemplate>


    <DataTemplate x:Key="DrawingPanelTemplate" DataType="{x:Type viewmodel:MapVM}">
        <Grid x:Name="DrawingPanelRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="DrawingToolBar" Content="{Binding DrawingPanel}" ContentTemplate="{DynamicResource DrawingPanelToolBarTemplate}"/>
            <ContentControl x:Name="MapResenderingViewer" Grid.Row="1" Content="{Binding ElementName=DrawingPanelRoot,Path=DataContext}" ContentTemplate="{DynamicResource MapViewerTemplate}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>