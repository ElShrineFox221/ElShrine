<controls:EWindow x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:controls="clr-namespace:ElShrine.Wpf.Controls;assembly=ElShrineLib.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" IsEnabled="True" UseLayoutRounding="True">
    <Grid>
        <Grid.Resources>
            <Style TargetType="Control">
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>
            <LinearGradientBrush x:Key="ColorSpectrumBrush" StartPoint="1,0" EndPoint="0,0">
                <GradientStop Color="#ff0000"/>
                <GradientStop Color="#ff00ff" Offset="0.207"/>
                <GradientStop Color="#0000ff" Offset="0.334"/>
                <GradientStop Color="#00ffff" Offset="0.501"/>
                <GradientStop Color="#00ff00" Offset="0.668"/>
                <GradientStop Color="#ffff00" Offset="0.835"/>
                <GradientStop Color="#ff0000" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:ETabControl x:Name="TestETB" Margin="40" Padding="10" SelectedIndex="2">
            <TabItem Header="ti1">
                <StackPanel>
                    <Rectangle Width="30" Height="30" Fill="{Binding RelativeSource={RelativeSource AncestorType=controls:EWindow},Path=PrimaryBrush}"/>
                    <controls:EImage x:Name="TestControl1" Height="100"/>
                    <StackPanel Orientation="Horizontal" Height="30">
                        <TextBox x:Name="TestTextBox"/>
                        <Button Content="Change confrim" Click="Button_Click_3"/>
                        <Button Content="Change refresh" Click="Button_Click_4"/>
                    </StackPanel>
                    <controls:EComboBox x:Name="TestCBB" Loaded="TestCBB_Loaded"/>
                    <controls:ETabControl HorizontalHeaderAlignment="Stretch">
                        <TabItem Header="ti1">
                            <TextBlock Text="Text1Text1Text1Text1Text1Text1Text1Text1Text1Text1Text1Text1Text1" Background="Red"/>
                        </TabItem>
                        <TabItem Header="ti2">
                            <TextBlock Text="Text2"/>
                        </TabItem>
                    </controls:ETabControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="ti2">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Height="30">
                        <controls:EToggleButton x:Name="TestBtn" IsChecked="True" Content="Button" Width="200"/>
                        <controls:EToggleButton x:Name="TestBtn1" IsChecked="False" Content="Button" Width="200"/>
                    </StackPanel>
                    <TextBlock Text="Test texts, akhfglah a ad faf"/>
                    <StackPanel Orientation="Horizontal" Height="30">
                        <Button Content="Change color" Click="Button_Click"/>
                        <Button Content="Change theme" Click="Button_Click_1"/>
                        <Button Content="Change fontsize" Click="Button_Click_2"/>
                    </StackPanel>


                    <controls:EExpander Header="Test" Margin="10">
                        <StackPanel>

                            <controls:EListBox Height="220" Margin="0">
                                <TextBlock Text="Text0" Width="200"/>
                                <TextBlock Text="Text1"/>
                                <TextBlock Text="Text2"/>
                                <TextBlock Text="Text3"/>
                                <TextBlock Text="Text4"/>
                                <TextBlock Text="Text0"/>
                                <TextBlock Text="Text1"/>
                                <TextBlock Text="Text2"/>
                                <TextBlock Text="Text3"/>
                                <TextBlock Text="Text4"/>
                                <TextBlock Text="Text0"/>
                                <TextBlock Text="Text1"/>
                                <TextBlock Text="Text2"/>
                                <TextBlock Text="Text3"/>
                                <TextBlock Text="Text4"/>
                            </controls:EListBox>
                        </StackPanel>
                    </controls:EExpander>
                    <controls:ETextBox x:Name="TestETextBox" NoticeInfo="Notice info"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="ti3">
                <Border Padding="10" Background="White" BorderThickness="3" BorderBrush="{Binding ElementName=Ele, Path=ResultColor, Converter={StaticResource CommonConverter}}">
                    <controls:EColorPalette x:Name="Ele"/>
                </Border>
            </TabItem>
        </controls:ETabControl>
        <Button Grid.Row="1" x:Name="TestBtn3" Click="TestBtn3_Click" Content="Test"/>
    </Grid>
</controls:EWindow>
